<!doctype lake><meta name="doc-version" content="1" /><meta name="viewport" content="fixed" /><meta name="typography" content="classic" /><meta name="paragraphSpacing" content="relax" /><p data-lake-id="u782722d3" id="u782722d3"><span data-lake-id="u6edcfc84" id="u6edcfc84">注：LR/SC 完全在 L1 处理，</span><code data-lake-id="u912b1901" id="u912b1901"><span data-lake-id="u0b8e0660" id="u0b8e0660">Excl</span></code><span data-lake-id="u89b9ba5d" id="u89b9ba5d"> 不出现在本接口中。</span></p><h2 data-lake-id="RRsc3" id="RRsc3"><span data-lake-id="udf71f966" id="udf71f966">1. 通道总览</span></h2><p data-lake-id="u0804e39d" id="u0804e39d"><span data-lake-id="u549d3f5e" id="u549d3f5e">这里的TX/RX指的是DCache视角的七个通道名。</span></p><table data-lake-id="a47Bh" id="a47Bh" margin="true" class="lake-table" style="width: 558px"><colgroup><col width="93"><col width="187"><col width="278"></colgroup><tbody><tr data-lake-id="u1553e9d9" id="u1553e9d9"><td data-lake-id="uc7e1c4c5" id="uc7e1c4c5"><p data-lake-id="ub86f1827" id="ub86f1827"><span data-lake-id="ud950f2db" id="ud950f2db">字段</span></p></td><td data-lake-id="u806b5ca6" id="u806b5ca6"><p data-lake-id="uf440c3c0" id="uf440c3c0"><span data-lake-id="uee00ecb5" id="uee00ecb5">方向</span></p></td><td data-lake-id="u689fe7c7" id="u689fe7c7"><p data-lake-id="ud0055892" id="ud0055892"><span data-lake-id="ucc2f886f" id="ucc2f886f">DCache 中的主要用途</span></p></td></tr><tr data-lake-id="u6466e578" id="u6466e578"><td data-lake-id="u1f3787a3" id="u1f3787a3"><p data-lake-id="u86c468b9" id="u86c468b9"><span data-lake-id="u2680ac8e" id="u2680ac8e">TXEVT</span></p></td><td data-lake-id="uc1eedb25" id="uc1eedb25"><p data-lake-id="u928369f4" id="u928369f4"><span data-lake-id="ue91072bc" id="ue91072bc">DCache → L2</span></p></td><td data-lake-id="u146664fd" id="u146664fd"><p data-lake-id="u0db8cbc7" id="u0db8cbc7"><span data-lake-id="u6c7c7b19" id="u6c7c7b19">clean eviction / dirty line writeback 的起始请求</span></p></td></tr><tr data-lake-id="u999608a0" id="u999608a0"><td data-lake-id="u03cbf37a" id="u03cbf37a"><p data-lake-id="u53d6eafa" id="u53d6eafa"><span data-lake-id="u28f217bc" id="u28f217bc">TXREQ</span></p></td><td data-lake-id="u972f92ed" id="u972f92ed"><p data-lake-id="ua16fddab" id="ua16fddab"><span data-lake-id="uf43cd359" id="uf43cd359">DCache → L2</span></p></td><td data-lake-id="u4fc0af92" id="u4fc0af92"><p data-lake-id="ud0113497" id="ud0113497"><span data-lake-id="u3b1d33d0" id="u3b1d33d0">load miss / 权限升级 / CMO / 整行或非缓存请求</span></p></td></tr><tr data-lake-id="u88d02217" id="u88d02217"><td data-lake-id="ue5786dea" id="ue5786dea"><p data-lake-id="u4040534c" id="u4040534c"><span data-lake-id="ud3de7563" id="ud3de7563">RXSNP</span></p></td><td data-lake-id="u32551c48" id="u32551c48"><p data-lake-id="uc968c30b" id="uc968c30b"><span data-lake-id="u04e060c2" id="u04e060c2">L2 → DCache</span></p></td><td data-lake-id="u54df25c7" id="u54df25c7"><p data-lake-id="u754aaf88" id="u754aaf88"><span data-lake-id="u47299301" id="u47299301">接收 L2 的 Snoop，相当于 TileLink Probe</span></p></td></tr><tr data-lake-id="u83d8f39f" id="u83d8f39f"><td data-lake-id="u22d10f41" id="u22d10f41"><p data-lake-id="ucafb2074" id="ucafb2074"><span data-lake-id="u11e439ca" id="u11e439ca">TXRSP</span></p></td><td data-lake-id="u3ede46c1" id="u3ede46c1"><p data-lake-id="u8c4f2460" id="u8c4f2460"><span data-lake-id="ufdbba89f" id="ufdbba89f">DCache → L2</span></p></td><td data-lake-id="u740febf8" id="u740febf8"><p data-lake-id="u64ca6fbb" id="u64ca6fbb"><span data-lake-id="uad791413" id="uad791413">返回无数据的 SnpResp，或发送 CompAck</span></p></td></tr><tr data-lake-id="uc28ac6b3" id="uc28ac6b3"><td data-lake-id="u8db2e9a0" id="u8db2e9a0"><p data-lake-id="u1b69e3cd" id="u1b69e3cd"><span data-lake-id="u307f6e29" id="u307f6e29">TXDAT</span></p></td><td data-lake-id="u39f59fd5" id="u39f59fd5"><p data-lake-id="u70c4818c" id="u70c4818c"><span data-lake-id="u767265b2" id="u767265b2">DCache → L2</span></p></td><td data-lake-id="u147015d1" id="u147015d1"><p data-lake-id="ud04ba112" id="ud04ba112"><span data-lake-id="u5eda4701" id="u5eda4701">返回 SnpRespData，或发送 CopyBackWrData</span></p></td></tr><tr data-lake-id="u095f63f5" id="u095f63f5"><td data-lake-id="u4bc27495" id="u4bc27495"><p data-lake-id="uaec61e94" id="uaec61e94"><span data-lake-id="ub9aee057" id="ub9aee057">RXRSP</span></p></td><td data-lake-id="ubbdf7b38" id="ubbdf7b38"><p data-lake-id="u7276253a" id="u7276253a"><span data-lake-id="u38d3f323" id="u38d3f323">L2 → DCache</span></p></td><td data-lake-id="u2e64e5f7" id="u2e64e5f7"><p data-lake-id="u931a74db" id="u931a74db"><span data-lake-id="ufddcef5b" id="ufddcef5b">接收 Comp / DBIDResp / CompDBIDResp / CompCMO</span></p></td></tr><tr data-lake-id="u214c0725" id="u214c0725"><td data-lake-id="u48e2a4c0" id="u48e2a4c0"><p data-lake-id="u03f31c42" id="u03f31c42"><span data-lake-id="u54bc0cca" id="u54bc0cca">RXDAT</span></p></td><td data-lake-id="ube04e48a" id="ube04e48a"><p data-lake-id="u97743474" id="u97743474"><span data-lake-id="u01d67541" id="u01d67541">L2 → DCache</span></p></td><td data-lake-id="ue444f777" id="ue444f777"><p data-lake-id="u48654bdd" id="u48654bdd"><span data-lake-id="ue0793c05" id="ue0793c05">接收 CompData，按 DataID 完成 refill</span></p></td></tr></tbody></table><p data-lake-id="u0093d178" id="u0093d178"><br></p><h2 data-lake-id="E0L26" id="E0L26"><span data-lake-id="u4b0e4ad6" id="u4b0e4ad6">2. 每条通道的握手信号</span></h2><table data-lake-id="XWm5o" id="XWm5o" margin="true" class="lake-table" style="width: 557px"><colgroup><col width="81"><col width="67"><col width="143"><col width="266"></colgroup><tbody><tr data-lake-id="u2f03257b" id="u2f03257b"><td data-lake-id="ue91e34c0" id="ue91e34c0"><p data-lake-id="ud6b422f4" id="ud6b422f4"><span data-lake-id="ua950e063" id="ua950e063">字段</span></p></td><td data-lake-id="u33049293" id="u33049293"><p data-lake-id="u855c3094" id="u855c3094" style="text-align: right"><span data-lake-id="uaa15a473" id="uaa15a473">位宽</span></p></td><td data-lake-id="u40ef96c5" id="u40ef96c5"><p data-lake-id="u616158da" id="u616158da"><span data-lake-id="u7392087e" id="u7392087e">方向</span></p></td><td data-lake-id="ubecc24cb" id="ubecc24cb"><p data-lake-id="ue4bbca6b" id="ue4bbca6b"><span data-lake-id="ubd8fe366" id="ubd8fe366">DCache 中的主要用途</span></p></td></tr><tr data-lake-id="ufe6f765c" id="ufe6f765c"><td data-lake-id="u2f594c79" id="u2f594c79"><p data-lake-id="u734abb1e" id="u734abb1e"><span data-lake-id="u139566ca" id="u139566ca">valid</span></p></td><td data-lake-id="ud9fa1ab7" id="ud9fa1ab7"><p data-lake-id="u6e8cb109" id="u6e8cb109" style="text-align: right"><span data-lake-id="ud405563a" id="ud405563a">1</span></p></td><td data-lake-id="u0b5f174e" id="u0b5f174e"><p data-lake-id="ued4ebd9e" id="ued4ebd9e"><span data-lake-id="u3faf508a" id="u3faf508a">发送方 → 接收方</span></p></td><td data-lake-id="ube138081" id="ube138081"><p data-lake-id="u4992bfb6" id="u4992bfb6"><span data-lake-id="u02571f52" id="u02571f52">当前周期 payload 有效</span></p></td></tr><tr data-lake-id="ue607ce22" id="ue607ce22" style="height: 63px"><td data-lake-id="u0b97cec9" id="u0b97cec9"><p data-lake-id="ueee65f16" id="ueee65f16"><span data-lake-id="u9e66cc4f" id="u9e66cc4f">ready</span></p></td><td data-lake-id="u5ed9aa86" id="u5ed9aa86"><p data-lake-id="uf7fe7afd" id="uf7fe7afd" style="text-align: right"><span data-lake-id="u122249d0" id="u122249d0">1</span></p></td><td data-lake-id="u98de6462" id="u98de6462"><p data-lake-id="ucf7badd6" id="ucf7badd6"><span data-lake-id="u931a8993" id="u931a8993">接收方 → 发送方</span></p></td><td data-lake-id="ud7b277a2" id="ud7b277a2"><p data-lake-id="u38aa4237" id="u38aa4237"><span data-lake-id="ua5121c00" id="ua5121c00">接收方可以接收；</span><code data-lake-id="u51df2381" id="u51df2381"><span data-lake-id="u9133ccf5" id="u9133ccf5">valid &amp;&amp; ready</span></code><span data-lake-id="ud0e1ce19" id="ud0e1ce19"> 时完成本拍传输</span></p></td></tr></tbody></table><p data-lake-id="u7d658941" id="u7d658941"><code data-lake-id="u2e8eaaea" id="u2e8eaaea"><span data-lake-id="uf7f2ee15" id="uf7f2ee15">ready=0</span></code><span data-lake-id="u7d45d752" id="u7d45d752"> 时，发送方必须保持 payload 不变。</span></p><h2 data-lake-id="SUnRY" id="SUnRY"><span data-lake-id="ua82704d8" id="ua82704d8">3. TXEVT</span></h2><p data-lake-id="u41180d3c" id="u41180d3c"><span data-lake-id="u220cf74b" id="u220cf74b">payload 6 个，加上 </span><code data-lake-id="u06dcef16" id="u06dcef16"><span data-lake-id="ud0349c91" id="ud0349c91">valid/ready</span></code><span data-lake-id="u68a07f9b" id="u68a07f9b"> 后共 8 个信号。方向为 DCache → L2。</span></p><p data-lake-id="u5b10cd20" id="u5b10cd20"><span data-lake-id="u55dc9a6f" id="u55dc9a6f">DCache中的WriteBackQueue部件与L2Cache通过TXEVT相联。</span></p><table data-lake-id="mG5eQ" id="mG5eQ" margin="true" class="lake-table" style="width: 565px"><colgroup><col width="92"><col width="72"><col width="154"><col width="247"></colgroup><tbody><tr data-lake-id="u69ccbaa0" id="u69ccbaa0"><td data-lake-id="ub26dfa30" id="ub26dfa30"><p data-lake-id="ucbe3c32f" id="ucbe3c32f"><span data-lake-id="u620f4351" id="u620f4351">字段</span></p></td><td data-lake-id="ue6fcbf2d" id="ue6fcbf2d"><p data-lake-id="u310cd314" id="u310cd314" style="text-align: right"><span data-lake-id="u3498dad1" id="u3498dad1">位宽</span></p></td><td data-lake-id="uc84cc080" id="uc84cc080"><p data-lake-id="uc0733623" id="uc0733623"><span data-lake-id="ud1c90166" id="ud1c90166">方向</span></p></td><td data-lake-id="ue5a85f79" id="ue5a85f79"><p data-lake-id="u619c90fc" id="u619c90fc"><span data-lake-id="ud344a5d5" id="ud344a5d5">DCache 中的主要用途</span></p></td></tr><tr data-lake-id="u0a943b8b" id="u0a943b8b"><td data-lake-id="u1e817527" id="u1e817527"><p data-lake-id="ua3489c94" id="ua3489c94"><span data-lake-id="u7fe397ae" id="u7fe397ae">txnId</span></p></td><td data-lake-id="ubcaf34b8" id="ubcaf34b8"><p data-lake-id="ua4c95b82" id="ua4c95b82" style="text-align: right"><span data-lake-id="u6f8434c2" id="u6f8434c2">8</span></p></td><td data-lake-id="u0f946913" id="u0f946913"><p data-lake-id="ua6697ee6" id="ua6697ee6"><span data-lake-id="u14cc063b" id="u14cc063b">DCache → L2</span></p></td><td data-lake-id="u656b1e78" id="u656b1e78"><p data-lake-id="u77066dcd" id="u77066dcd"><span data-lake-id="ucb713391" id="ucb713391">Evict 或 WriteBackFull 的事务 ID，用于匹配后续 RXRSP</span></p></td></tr><tr data-lake-id="ucd35f099" id="ucd35f099"><td data-lake-id="ueec1703c" id="ueec1703c"><p data-lake-id="uf5e58475" id="uf5e58475"><span data-lake-id="u6bfbf095" id="u6bfbf095">srcId</span></p></td><td data-lake-id="ubad58c3a" id="ubad58c3a"><p data-lake-id="ud4fde2f2" id="ud4fde2f2" style="text-align: right"><span data-lake-id="ud5152428" id="ud5152428">7</span></p></td><td data-lake-id="ua5062a51" id="ua5062a51"><p data-lake-id="ubb6a9ec2" id="ubb6a9ec2"><span data-lake-id="u20ad38cc" id="u20ad38cc">DCache → L2</span></p></td><td data-lake-id="u8610a6bd" id="u8610a6bd"><p data-lake-id="u1f15692d" id="u1f15692d"><span data-lake-id="u4d7e11ad" id="u4d7e11ad">上游来源节点；DCache 固定使用自己的 NodeID</span></p></td></tr><tr data-lake-id="u26aebb58" id="u26aebb58"><td data-lake-id="ua3f1a777" id="ua3f1a777"><p data-lake-id="uc8ab600a" id="uc8ab600a"><span data-lake-id="u288e5c13" id="u288e5c13">tgtId</span></p></td><td data-lake-id="u5545c2cb" id="u5545c2cb"><p data-lake-id="uc3063909" id="uc3063909" style="text-align: right"><span data-lake-id="uf5f86fcd" id="uf5f86fcd">7</span></p></td><td data-lake-id="u55fb6fed" id="u55fb6fed"><p data-lake-id="u88bf90c8" id="u88bf90c8"><span data-lake-id="u35075e52" id="u35075e52">DCache → L2</span></p></td><td data-lake-id="ua3a1cbe7" id="ua3a1cbe7"><p data-lake-id="u5c9c2611" id="u5c9c2611"><span data-lake-id="uea0b0fa8" id="uea0b0fa8">目标 L2 节点</span></p></td></tr><tr data-lake-id="u066cf038" id="u066cf038"><td data-lake-id="u626e89ad" id="u626e89ad"><p data-lake-id="u27606049" id="u27606049"><span data-lake-id="ud801706a" id="ud801706a">opcode</span></p></td><td data-lake-id="u999c052c" id="u999c052c"><p data-lake-id="uc88b2f8a" id="uc88b2f8a" style="text-align: right"><span data-lake-id="u830d3cc3" id="u830d3cc3">1</span></p></td><td data-lake-id="u237fd872" id="u237fd872"><p data-lake-id="u9796880f" id="u9796880f"><span data-lake-id="uac7c63b8" id="uac7c63b8">DCache → L2</span></p></td><td data-lake-id="u9e0e84ff" id="u9e0e84ff"><p data-lake-id="ubb9242bc" id="ubb9242bc"><span data-lake-id="ub2dd66dc" id="ub2dd66dc">0 表示 Evict，1 表示 WriteBackFull</span></p></td></tr><tr data-lake-id="uf3c10f46" id="uf3c10f46"><td data-lake-id="u7f0fbf4e" id="u7f0fbf4e"><p data-lake-id="u67601baf" id="u67601baf"><span data-lake-id="ub01104cc" id="ub01104cc">addr</span></p></td><td data-lake-id="ub73caeec" id="ub73caeec"><p data-lake-id="u08226bb1" id="u08226bb1" style="text-align: right"><span data-lake-id="ue73a377e" id="ue73a377e">45</span></p></td><td data-lake-id="ub6b8b2d0" id="ub6b8b2d0"><p data-lake-id="uf5b30ece" id="uf5b30ece"><span data-lake-id="uf007486c" id="uf007486c">DCache → L2</span></p></td><td data-lake-id="u6206a411" id="u6206a411"><p data-lake-id="u00cd9339" id="u00cd9339"><span data-lake-id="u495a1e43" id="u495a1e43">被替换 cache line 的物理地址</span></p></td></tr><tr data-lake-id="u31e5bdd5" id="u31e5bdd5"><td data-lake-id="u6bd02c96" id="u6bd02c96"><p data-lake-id="ud20ef899" id="ud20ef899"><span data-lake-id="u640b9f2b" id="u640b9f2b">ns</span></p></td><td data-lake-id="u486061d4" id="u486061d4"><p data-lake-id="uf8dce245" id="uf8dce245" style="text-align: right"><span data-lake-id="udccd2a7a" id="udccd2a7a">1</span></p></td><td data-lake-id="u23d18114" id="u23d18114"><p data-lake-id="u468c0eed" id="u468c0eed"><span data-lake-id="ua9775e8e" id="ua9775e8e">DCache → L2</span></p></td><td data-lake-id="u2d92c6bd" id="u2d92c6bd"><p data-lake-id="u335622a5" id="u335622a5"><span data-lake-id="u9c644b26" id="u9c644b26">secure/Nonsecure，固定填0</span></p></td></tr><tr data-lake-id="u308725c2" id="u308725c2"><td data-lake-id="uc66dd907" id="uc66dd907"><p data-lake-id="u806a3121" id="u806a3121"><span data-lake-id="u0ff95211" id="u0ff95211">memAttr</span></p></td><td data-lake-id="u5b92dd44" id="u5b92dd44"><p data-lake-id="uff754096" id="uff754096" style="text-align: right"><span data-lake-id="u1651eeb2" id="u1651eeb2">1</span></p></td><td data-lake-id="u5f010b31" id="u5f010b31"><p data-lake-id="u441929d8" id="u441929d8"><span data-lake-id="u4d39a695" id="u4d39a695">DCache → L2</span></p></td><td data-lake-id="u1345a8fa" id="u1345a8fa"><p data-lake-id="uce256f77" id="uce256f77"><span data-lake-id="uaf3fbcc5" id="uaf3fbcc5">表示内存属性</span></p></td></tr><tr data-lake-id="u5d87aa5b" id="u5d87aa5b"><td data-lake-id="u3741e70e" id="u3741e70e"><p data-lake-id="u3ab46266" id="u3ab46266"><span data-lake-id="u8613dfaf" id="u8613dfaf">wayValid</span></p></td><td data-lake-id="ucc4a6f96" id="ucc4a6f96"><p data-lake-id="u0d77e6a9" id="u0d77e6a9" style="text-align: right"><span data-lake-id="ua7949a47" id="ua7949a47">1</span></p></td><td data-lake-id="u089f0bbb" id="u089f0bbb"><p data-lake-id="u4e97f367" id="u4e97f367"><span data-lake-id="u019151e3" id="u019151e3">DCache → L2</span></p></td><td data-lake-id="uc79be850" id="uc79be850"><p data-lake-id="ue7ce4915" id="ue7ce4915"><span data-lake-id="u0e75dd59" id="u0e75dd59">AnserL2忽略，暂时不用填0</span></p></td></tr><tr data-lake-id="u88511489" id="u88511489"><td data-lake-id="ua246dd82" id="ua246dd82"><p data-lake-id="u050586bf" id="u050586bf"><span data-lake-id="udf654b6a" id="udf654b6a">way</span></p></td><td data-lake-id="u0262c307" id="u0262c307"><p data-lake-id="ua824fa0d" id="ua824fa0d" style="text-align: right"><span data-lake-id="u8bf57215" id="u8bf57215">nWays</span></p></td><td data-lake-id="ubeab9517" id="ubeab9517"><p data-lake-id="u883985a2" id="u883985a2"><span data-lake-id="u7f135b35" id="u7f135b35">DCache → L2</span></p></td><td data-lake-id="ua4c6887d" id="ua4c6887d"><p data-lake-id="u790e9605" id="u790e9605"><span data-lake-id="u6283c47d" id="u6283c47d">l1告诉l2这行在哪一路</span></p></td></tr><tr data-lake-id="u4d6a4323" id="u4d6a4323"><td data-lake-id="uaffe3da5" id="uaffe3da5"><p data-lake-id="ud442903f" id="ud442903f"><span data-lake-id="u644a3350" id="u644a3350">traceTag</span></p></td><td data-lake-id="u895100e2" id="u895100e2"><p data-lake-id="ub3d6a843" id="ub3d6a843" style="text-align: right"><span data-lake-id="ubf5436ce" id="ubf5436ce">1</span></p></td><td data-lake-id="u6d66f950" id="u6d66f950"><p data-lake-id="u674935cb" id="u674935cb"><span data-lake-id="u5f89fd4f" id="u5f89fd4f">DCache → L2</span></p></td><td data-lake-id="u74aa465e" id="u74aa465e"><p data-lake-id="u37506cf3" id="u37506cf3"><span data-lake-id="u55108378" id="u55108378">调试追踪标记</span></p></td></tr></tbody></table><p data-lake-id="u4996976c" id="u4996976c"><code data-lake-id="ucd21becc" id="ucd21becc"><span data-lake-id="u4c2e8243" id="u4c2e8243">opcode=0</span></code><span data-lake-id="u84c367c6" id="u84c367c6"> 表示 clean eviction，只等待完成响应。</span><code data-lake-id="u3105bb0d" id="u3105bb0d"><span data-lake-id="u71f98315" id="u71f98315">opcode=1</span></code><span data-lake-id="u85fa34c8" id="u85fa34c8"> 表示 dirty writeback，必须先收到 DBID，才能从 TXDAT 发送数据。</span></p><h2 data-lake-id="gR6Fg" id="gR6Fg"><span data-lake-id="ud31b4590" id="ud31b4590">4. TXREQ</span></h2><p data-lake-id="ud3b1062b" id="ud3b1062b"><span data-lake-id="uc25165b9" id="uc25165b9">payload 10 个，加上 </span><code data-lake-id="ua672b29c" id="ua672b29c"><span data-lake-id="u19c44fa4" id="u19c44fa4">valid/ready</span></code><span data-lake-id="u406a7fc6" id="u406a7fc6"> 后共 12 个信号。方向为 DCache → L2。</span></p><p data-lake-id="uc6950c9e" id="uc6950c9e"><span data-lake-id="u2696f4a6" id="u2696f4a6">DCache中的MissQueue与L2Cache通过TXREQ相联。</span></p><table data-lake-id="ZXZ5O" id="ZXZ5O" margin="true" class="lake-table" style="width: 584px"><colgroup><col width="124"><col width="74"><col width="131"><col width="255"></colgroup><tbody><tr data-lake-id="uf5a3eff9" id="uf5a3eff9"><td data-lake-id="u8919e965" id="u8919e965"><p data-lake-id="u4677329b" id="u4677329b"><span data-lake-id="u089374d7" id="u089374d7">字段</span></p></td><td data-lake-id="u233bd8c3" id="u233bd8c3"><p data-lake-id="ue2ae52cb" id="ue2ae52cb" style="text-align: right"><span data-lake-id="uf989fbd5" id="uf989fbd5">位宽</span></p></td><td data-lake-id="uf56d53b7" id="uf56d53b7"><p data-lake-id="u7b47f94b" id="u7b47f94b"><span data-lake-id="u0ea4543a" id="u0ea4543a">方向</span></p></td><td data-lake-id="udb0d2fae" id="udb0d2fae"><p data-lake-id="u769bdc1c" id="u769bdc1c"><span data-lake-id="u8809ee57" id="u8809ee57">DCache 中的主要用途</span></p></td></tr><tr data-lake-id="u3ab0e734" id="u3ab0e734"><td data-lake-id="u1e4d8133" id="u1e4d8133"><p data-lake-id="u94ab8ae1" id="u94ab8ae1"><span data-lake-id="u0006958d" id="u0006958d">txnId</span></p></td><td data-lake-id="u775ca51d" id="u775ca51d"><p data-lake-id="u4742cc7c" id="u4742cc7c" style="text-align: right"><span data-lake-id="ufa248a02" id="ufa248a02">8</span></p></td><td data-lake-id="u366a7e34" id="u366a7e34"><p data-lake-id="u14904cd7" id="u14904cd7"><span data-lake-id="ucba4e017" id="ucba4e017">DCache → L2</span></p></td><td data-lake-id="ud89bdd31" id="ud89bdd31"><p data-lake-id="uf5ca6d33" id="uf5ca6d33"><span data-lake-id="u4dcca337" id="u4dcca337">请求事务 ID，用于匹配 RXRSP 和 RXDAT</span></p></td></tr><tr data-lake-id="uf6d0bc3b" id="uf6d0bc3b"><td data-lake-id="u2e51c208" id="u2e51c208"><p data-lake-id="u72c6dbf4" id="u72c6dbf4"><span data-lake-id="u04b27b64" id="u04b27b64">srcId</span></p></td><td data-lake-id="u79c1dcfe" id="u79c1dcfe"><p data-lake-id="uffca90b9" id="uffca90b9" style="text-align: right"><span data-lake-id="u658d0042" id="u658d0042">7</span></p></td><td data-lake-id="uca5c6069" id="uca5c6069"><p data-lake-id="u05120c72" id="u05120c72"><span data-lake-id="uff344247" id="uff344247">DCache → L2</span></p></td><td data-lake-id="uead35953" id="uead35953"><p data-lake-id="ucb0a0456" id="ucb0a0456"><span data-lake-id="u4c08171c" id="u4c08171c">请求来源节点，标识 DCache</span></p></td></tr><tr data-lake-id="u8cb3b0ce" id="u8cb3b0ce"><td data-lake-id="u8538e5ce" id="u8538e5ce"><p data-lake-id="u5a9c9d64" id="u5a9c9d64"><span data-lake-id="u7388d2e7" id="u7388d2e7">tgtId</span></p></td><td data-lake-id="u223bc5f3" id="u223bc5f3"><p data-lake-id="ua876f1df" id="ua876f1df" style="text-align: right"><span data-lake-id="uae8ff372" id="uae8ff372">7</span></p></td><td data-lake-id="ucd977cfc" id="ucd977cfc"><p data-lake-id="u9b425452" id="u9b425452"><span data-lake-id="udcfbbca7" id="udcfbbca7">DCache → L2</span></p></td><td data-lake-id="u78c05498" id="u78c05498"><p data-lake-id="u50d68d02" id="u50d68d02"><span data-lake-id="u91c7a29b" id="u91c7a29b">请求目标 L2 节点</span></p></td></tr><tr data-lake-id="u4b5e17e8" id="u4b5e17e8"><td data-lake-id="ubeeb8749" id="ubeeb8749"><p data-lake-id="u90100341" id="u90100341"><span data-lake-id="u45326383" id="u45326383">opcode</span></p></td><td data-lake-id="uf5ad7331" id="uf5ad7331"><p data-lake-id="ud936e69f" id="ud936e69f" style="text-align: right"><span data-lake-id="u95ebcde2" id="u95ebcde2">6</span></p></td><td data-lake-id="u0eaaa48b" id="u0eaaa48b"><p data-lake-id="u360d228f" id="u360d228f"><span data-lake-id="u09485952" id="u09485952">DCache → L2</span></p></td><td data-lake-id="u79b299e6" id="u79b299e6"><p data-lake-id="ub9820454" id="ub9820454"><span data-lake-id="uf7d9e0f4" id="uf7d9e0f4">请求类型，如 ReadShared、ReadUnique、MakeUnique、CMO</span></p></td></tr><tr data-lake-id="u336d65d4" id="u336d65d4"><td data-lake-id="u5238f075" id="u5238f075"><p data-lake-id="u719bd1db" id="u719bd1db"><span data-lake-id="u59c3d482" id="u59c3d482">size</span></p></td><td data-lake-id="ud1d30548" id="ud1d30548"><p data-lake-id="u22dc6254" id="u22dc6254" style="text-align: right"><span data-lake-id="u40676ea8" id="u40676ea8">3</span></p></td><td data-lake-id="u1463926b" id="u1463926b"><p data-lake-id="ue7950592" id="ue7950592"><span data-lake-id="u649f4ac8" id="u649f4ac8">DCache → L2</span></p></td><td data-lake-id="u6785a800" id="u6785a800"><p data-lake-id="u8e1d7587" id="u8e1d7587"><span data-lake-id="ub5dd9762" id="ub5dd9762">传输字节数的 log2 编码；64B cache line 填 6</span></p></td></tr><tr data-lake-id="u16c3b326" id="u16c3b326"><td data-lake-id="u6e6ffde9" id="u6e6ffde9"><p data-lake-id="u4f695e67" id="u4f695e67"><span data-lake-id="u92a07c7a" id="u92a07c7a">addr</span></p></td><td data-lake-id="u37de9e80" id="u37de9e80"><p data-lake-id="u1930525e" id="u1930525e" style="text-align: right"><span data-lake-id="u24061e84" id="u24061e84">48</span></p></td><td data-lake-id="u69f3c7c7" id="u69f3c7c7"><p data-lake-id="udcb9ae24" id="udcb9ae24"><span data-lake-id="ua2395261" id="ua2395261">DCache → L2</span></p></td><td data-lake-id="ub3e5800a" id="ub3e5800a"><p data-lake-id="uf3890698" id="uf3890698"><span data-lake-id="u313bd205" id="u313bd205">请求的物理地址</span></p></td></tr><tr data-lake-id="ud350aa6e" id="ud350aa6e" style="height: 63px"><td data-lake-id="u5c26f9e3" id="u5c26f9e3"><p data-lake-id="u39a715ad" id="u39a715ad"><span data-lake-id="u9c3c22bd" id="u9c3c22bd">tagAlias</span></p></td><td data-lake-id="u2c4e9c83" id="u2c4e9c83"><p data-lake-id="u368d7962" id="u368d7962" style="text-align: right"><span data-lake-id="u9749031b" id="u9749031b">2</span></p></td><td data-lake-id="u250a882f" id="u250a882f"><p data-lake-id="ue4b49c65" id="ue4b49c65"><span data-lake-id="u928fac2a" id="u928fac2a">DCache → L2</span></p></td><td data-lake-id="u629ff30b" id="u629ff30b"><p data-lake-id="ue4cf9a03" id="ue4cf9a03"><span data-lake-id="u929ce371" id="u929ce371">VIPT alias，对应 </span><code data-lake-id="u2fb9600b" id="u2fb9600b"><span data-lake-id="uebb8a1c6" id="uebb8a1c6">vaddr[13:12]</span></code><span data-lake-id="u09fa27e7" id="u09fa27e7">，辅助定位 cache line</span></p></td></tr><tr data-lake-id="u5a346da6" id="u5a346da6"><td data-lake-id="u4aafbbcb" id="u4aafbbcb"><p data-lake-id="ude9e0c6e" id="ude9e0c6e"><span data-lake-id="u8c58d144" id="u8c58d144"> ns</span></p></td><td data-lake-id="u4297835d" id="u4297835d"><p data-lake-id="u260ec572" id="u260ec572" style="text-align: right"><span data-lake-id="u5f82682f" id="u5f82682f">1</span></p></td><td data-lake-id="u71c50d95" id="u71c50d95"><p data-lake-id="ub67fdebe" id="ub67fdebe"><span data-lake-id="u7473d098" id="u7473d098">DCache → L2</span></p></td><td data-lake-id="u7144bda9" id="u7144bda9"><p data-lake-id="u0c69695c" id="u0c69695c"><span data-lake-id="u29043ca9" id="u29043ca9">secure/Nonsecure，固定填0</span></p></td></tr><tr data-lake-id="udd45f023" id="udd45f023"><td data-lake-id="ua9a55fd9" id="ua9a55fd9"><p data-lake-id="u4c2b2b4a" id="u4c2b2b4a"><span data-lake-id="ud0f61dbf" id="ud0f61dbf">order</span></p></td><td data-lake-id="u8a6019ec" id="u8a6019ec"><p data-lake-id="u34f6df69" id="u34f6df69" style="text-align: right"><span data-lake-id="u8192331b" id="u8192331b">2</span></p></td><td data-lake-id="ue07aa13d" id="ue07aa13d"><p data-lake-id="uc7f742df" id="uc7f742df"><span data-lake-id="u8849a78c" id="u8849a78c">DCache → L2</span></p></td><td data-lake-id="u627c35ce" id="u627c35ce"><p data-lake-id="u79ba43c1" id="u79ba43c1"><span data-lake-id="ue79ee6e1" id="ue79ee6e1">是否可以out of order</span></p></td></tr><tr data-lake-id="ue7b419c9" id="ue7b419c9"><td data-lake-id="ua3a38664" id="ua3a38664"><p data-lake-id="ucdfa7c0e" id="ucdfa7c0e"><span data-lake-id="u06b4d411" id="u06b4d411">memAttr</span></p></td><td data-lake-id="u4c235b04" id="u4c235b04"><p data-lake-id="u4783838b" id="u4783838b" style="text-align: right"><span data-lake-id="ua76593aa" id="ua76593aa">4</span></p></td><td data-lake-id="u27a96b3a" id="u27a96b3a"><p data-lake-id="u96924ba4" id="u96924ba4"><span data-lake-id="u0f4f2e1a" id="u0f4f2e1a">DCache → L2</span></p></td><td data-lake-id="uc2a7f2cb" id="uc2a7f2cb"><p data-lake-id="ue1656685" id="ue1656685"><span data-lake-id="u17da24d3" id="u17da24d3">内存属性</span></p></td></tr><tr data-lake-id="u6c850854" id="u6c850854"><td data-lake-id="u5c3e79b4" id="u5c3e79b4"><p data-lake-id="uaf16e42a" id="uaf16e42a"><span data-lake-id="ubc063378" id="ubc063378">excl</span></p></td><td data-lake-id="ueb759203" id="ueb759203"><p data-lake-id="u9ba1e558" id="u9ba1e558" style="text-align: right"><span data-lake-id="u1b598199" id="u1b598199">1</span></p></td><td data-lake-id="u435d2158" id="u435d2158"><p data-lake-id="ufea7d5f4" id="ufea7d5f4"><span data-lake-id="ua5ee7e90" id="ua5ee7e90">DCache → L2</span></p></td><td data-lake-id="u1c921713" id="u1c921713"><p data-lake-id="ub734e6c4" id="ub734e6c4"><span data-lake-id="udf35dbf8" id="udf35dbf8">LR/SC交给L2来做吗？YQH的reservation在L1，因此填0</span></p></td></tr><tr data-lake-id="u3221a058" id="u3221a058"><td data-lake-id="ub7b63511" id="ub7b63511"><p data-lake-id="ubf143180" id="ubf143180"><span data-lake-id="u4b8b2654" id="u4b8b2654">expCompData</span></p></td><td data-lake-id="u9070784b" id="u9070784b"><p data-lake-id="ud6d976ad" id="ud6d976ad" style="text-align: right"><span data-lake-id="u8d5ad8e7" id="u8d5ad8e7">1</span></p></td><td data-lake-id="ucc06ffce" id="ucc06ffce"><p data-lake-id="u6488e0c3" id="u6488e0c3"><span data-lake-id="u8a13d4fe" id="u8a13d4fe">DCache → L2</span></p></td><td data-lake-id="u839b5628" id="u839b5628"><p data-lake-id="ucffd8d92" id="ucffd8d92"><span data-lake-id="u31f68035" id="u31f68035">是否必须返回旧数据；区分部分 Store/AMO 与整行覆盖</span></p></td></tr><tr data-lake-id="u5de84008" id="u5de84008"><td data-lake-id="u1285368b" id="u1285368b"><p data-lake-id="u26853db1" id="u26853db1"><span data-lake-id="ubd85587f" id="ubd85587f">expCompStash</span></p></td><td data-lake-id="ub15e50fa" id="ub15e50fa"><p data-lake-id="ua86586dc" id="ua86586dc" style="text-align: right"><span data-lake-id="ua29440e4" id="ua29440e4">1</span></p></td><td data-lake-id="ua9929f3f" id="ua9929f3f"><p data-lake-id="u58308eda" id="u58308eda"><span data-lake-id="u94cd3655" id="u94cd3655">DCache → L2</span></p></td><td data-lake-id="u6a09c742" id="u6a09c742"><p data-lake-id="ud90043fa" id="ud90043fa"><span data-lake-id="ud006b59f" id="ud006b59f">Stash 请求是否要求 L2 返回确认</span></p></td></tr><tr data-lake-id="ue4329aee" id="ue4329aee"><td data-lake-id="uc6bc412f" id="uc6bc412f"><p data-lake-id="u5fcb3b23" id="u5fcb3b23"><span data-lake-id="u0eba3f54" id="u0eba3f54">wayValid</span></p></td><td data-lake-id="u01b221ff" id="u01b221ff"><p data-lake-id="ud5eb4e63" id="ud5eb4e63" style="text-align: right"><span data-lake-id="u07cce535" id="u07cce535">1</span></p></td><td data-lake-id="u6020a353" id="u6020a353"><p data-lake-id="u3f3decf7" id="u3f3decf7"><span data-lake-id="u26e4cb5d" id="u26e4cb5d">DCache → L2</span></p></td><td data-lake-id="ub1f65ef4" id="ub1f65ef4"><p data-lake-id="u4aa31663" id="u4aa31663"><span data-lake-id="u84306ef4" id="u84306ef4">AnserL2忽略，暂时不用填0</span></p></td></tr><tr data-lake-id="ua5b604fa" id="ua5b604fa"><td data-lake-id="ub86859ff" id="ub86859ff"><p data-lake-id="u069b5834" id="u069b5834"><span data-lake-id="uf9092f44" id="uf9092f44">way</span></p></td><td data-lake-id="u4c159348" id="u4c159348"><p data-lake-id="ue74b750b" id="ue74b750b" style="text-align: right"><span data-lake-id="u0f5cc761" id="u0f5cc761">nways</span></p></td><td data-lake-id="ub8ffe17f" id="ub8ffe17f"><p data-lake-id="u6dc9cf1e" id="u6dc9cf1e"><span data-lake-id="u800066c8" id="u800066c8">DCache → L2</span></p></td><td data-lake-id="udfd0c5ed" id="udfd0c5ed"><p data-lake-id="ubc72737e" id="ubc72737e"><span data-lake-id="ub2d20249" id="ub2d20249">l1告诉l2这行在哪一路</span></p></td></tr><tr data-lake-id="u5416da5d" id="u5416da5d"><td data-lake-id="uae47aab1" id="uae47aab1"><p data-lake-id="ua67ccb2c" id="ua67ccb2c"><span data-lake-id="u8552466d" id="u8552466d">traceTag</span></p></td><td data-lake-id="ua1f760aa" id="ua1f760aa"><p data-lake-id="u482e395e" id="u482e395e" style="text-align: right"><span data-lake-id="ue3dd98e8" id="ue3dd98e8">1</span></p></td><td data-lake-id="u301f3867" id="u301f3867"><p data-lake-id="u79b01f20" id="u79b01f20"><span data-lake-id="u4ad28898" id="u4ad28898">DCache → L2</span></p></td><td data-lake-id="u159c1a5e" id="u159c1a5e"><p data-lake-id="u0e6b8040" id="u0e6b8040"><span data-lake-id="uac84b743" id="uac84b743">调试追踪标记</span></p></td></tr></tbody></table><p data-lake-id="u958361b4" id="u958361b4"><span data-lake-id="u009114c7" id="u009114c7">该通道承载 load miss、权限升级、CMO 等非 eviction 请求。LR/SC 不通过 </span><code data-lake-id="u2659d15a" id="u2659d15a"><span data-lake-id="ue5c27e91" id="ue5c27e91">Excl</span></code><span data-lake-id="u5a73c978" id="u5a73c978"> 交给 L2，reservation 由 L1 自己维护。</span></p><h2 data-lake-id="max65" id="max65"><span data-lake-id="u4fc03f90" id="u4fc03f90">5. RXSNP</span></h2><p data-lake-id="u10c6de72" id="u10c6de72"><span data-lake-id="uf78ace44" id="uf78ace44">payload 6 个，加上 </span><code data-lake-id="u9c5a0083" id="u9c5a0083"><span data-lake-id="uf16b62c9" id="uf16b62c9">valid/ready</span></code><span data-lake-id="u7f8383b1" id="u7f8383b1"> 后共 8 个信号。方向为 L2 → DCache。</span></p><p data-lake-id="uaafaf4d5" id="uaafaf4d5"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F35409901%2F1793101278500-953130c1-df54-485e-b870-2534ab6c4f45.png%22%2C%22taskId%22%3A%22uaf15c851-4850-4992-aae0-b599fecc99b%22%2C%22clientId%22%3A%22uf99025bd-5e23-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A554.1333333333333%2C%22height%22%3A225%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A98921%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A1039%2C%22originHeight%22%3A421%2C%22ratio%22%3A1.5%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%225.RXRSP%E5%B8%A6%E4%B8%8A%E4%BA%86TAGAIAS-00(OLD)%E7%9A%84%E7%89%A9%E7%90%86%E5%9C%B0%E5%9D%80X%E6%97%A0%E6%95%88%E5%8C%96%22%2C%22x%22%3A284%2C%22y%22%3A267%2C%22width%22%3A501%2C%22height%22%3A23%7D%2C%7B%22text%22%3A%221.TXREQ%E5%B8%A6%E4%B8%8A%E4%BA%86TAGALIAS%3D00%E7%9A%84%E7%89%A9%E7%90%86%E5%9C%B0%E5%9D%80X%22%2C%22x%22%3A323%2C%22y%22%3A62%2C%22width%22%3A383%2C%22height%22%3A21%7D%2C%7B%22text%22%3A%223.TXREQ%E5%B8%A6%E4%B8%8A%E4%BA%8