ke-id="uabd039dc" id="uabd039dc"><span data-lake-id="u2b0745c8" id="u2b0745c8">DCache中的ProbeQueue部件与L2Cache通过RXSNP相联。</span></p><table data-lake-id="O4TdQ" id="O4TdQ" margin="true" class="lake-table" style="width: 544px"><colgroup><col width="102"><col width="75"><col width="128"><col width="239"></colgroup><tbody><tr data-lake-id="ub66ed9f8" id="ub66ed9f8"><td data-lake-id="u87d64937" id="u87d64937"><p data-lake-id="u1133e2f4" id="u1133e2f4"><span data-lake-id="u56c56acf" id="u56c56acf">字段</span></p></td><td data-lake-id="ub2cc4636" id="ub2cc4636"><p data-lake-id="u6f207eba" id="u6f207eba" style="text-align: right"><span data-lake-id="u789cbce9" id="u789cbce9">位宽</span></p></td><td data-lake-id="u55329c68" id="u55329c68"><p data-lake-id="ufbe0db65" id="ufbe0db65"><span data-lake-id="ub9b56c1b" id="ub9b56c1b">方向</span></p></td><td data-lake-id="uc1a479d1" id="uc1a479d1"><p data-lake-id="uf1be539a" id="uf1be539a"><span data-lake-id="u1b31a760" id="u1b31a760">DCache 中的主要用途</span></p></td></tr><tr data-lake-id="ucdaeab66" id="ucdaeab66"><td data-lake-id="u464f18e9" id="u464f18e9"><p data-lake-id="uc44a9aa6" id="uc44a9aa6"><span data-lake-id="ud4a5a34c" id="ud4a5a34c">txnId</span></p></td><td data-lake-id="u68d6f9c0" id="u68d6f9c0"><p data-lake-id="uadb56405" id="uadb56405" style="text-align: right"><span data-lake-id="u66d3767e" id="u66d3767e">8</span></p></td><td data-lake-id="u004a326b" id="u004a326b"><p data-lake-id="u42c29a8d" id="u42c29a8d"><span data-lake-id="ucc3e5366" id="ucc3e5366">L2 → DCache</span></p></td><td data-lake-id="uae091f0f" id="uae091f0f"><p data-lake-id="ud87f38a0" id="ud87f38a0"><span data-lake-id="u6a555c4c" id="u6a555c4c">L2 分配的 Snoop 事务 ID；回答时必须原样带回</span></p></td></tr><tr data-lake-id="u8a6dceeb" id="u8a6dceeb"><td data-lake-id="u36bf560b" id="u36bf560b"><p data-lake-id="ua93d45c3" id="ua93d45c3"><span data-lake-id="uf6934d5c" id="uf6934d5c">srcId</span></p></td><td data-lake-id="u9fac2fc8" id="u9fac2fc8"><p data-lake-id="u9e54e25a" id="u9e54e25a" style="text-align: right"><span data-lake-id="ud4aedda8" id="ud4aedda8">7</span></p></td><td data-lake-id="ud040fb3b" id="ud040fb3b"><p data-lake-id="u1c9a908d" id="u1c9a908d"><span data-lake-id="ua8828470" id="ua8828470">L2 → DCache</span></p></td><td data-lake-id="ube97181a" id="ube97181a"><p data-lake-id="u0c04b5f8" id="u0c04b5f8"><span data-lake-id="ua3f6fa60" id="ua3f6fa60">发出 Snoop 的 L2 节点</span></p></td></tr><tr data-lake-id="u19ae7313" id="u19ae7313"><td data-lake-id="u797f79ad" id="u797f79ad"><p data-lake-id="u25f2a127" id="u25f2a127"><span data-lake-id="udce7b966" id="udce7b966">tgtId</span></p></td><td data-lake-id="u0023996a" id="u0023996a"><p data-lake-id="u657fd055" id="u657fd055" style="text-align: right"><span data-lake-id="uf9085446" id="uf9085446">7</span></p></td><td data-lake-id="u59ab6685" id="u59ab6685"><p data-lake-id="uec5c6733" id="uec5c6733"><span data-lake-id="ubae1f0f5" id="ubae1f0f5">L2 → DCache</span></p></td><td data-lake-id="uc3f98859" id="uc3f98859"><p data-lake-id="u792e9203" id="u792e9203"><span data-lake-id="u0e5da29e" id="u0e5da29e">Snoop 的目标上游节点，用于确认是否发给本 DCache</span></p></td></tr><tr data-lake-id="ub52d93e2" id="ub52d93e2"><td data-lake-id="ue442f336" id="ue442f336"><p data-lake-id="u18852f35" id="u18852f35"><span data-lake-id="u0e13d331" id="u0e13d331">opcode</span></p></td><td data-lake-id="u1d1d3bff" id="u1d1d3bff"><p data-lake-id="u33953e08" id="u33953e08" style="text-align: right"><span data-lake-id="u66e50ba7" id="u66e50ba7">2</span></p></td><td data-lake-id="u40ec02e9" id="u40ec02e9"><p data-lake-id="u4e8cc8f2" id="u4e8cc8f2"><span data-lake-id="u2342a30a" id="u2342a30a">L2 → DCache</span></p></td><td data-lake-id="u4be73b42" id="u4be73b42"><p data-lake-id="uadb500e1" id="uadb500e1"><span data-lake-id="u0696adf6" id="u0696adf6">Snoop 类型：失效、降为共享或清理脏责任</span></p></td></tr><tr data-lake-id="u0437626b" id="u0437626b"><td data-lake-id="u94dfd76f" id="u94dfd76f"><p data-lake-id="u72e080bb" id="u72e080bb"><span data-lake-id="u1c620f74" id="u1c620f74">addr</span></p></td><td data-lake-id="u797f3798" id="u797f3798"><p data-lake-id="uc423b6d3" id="uc423b6d3" style="text-align: right"><span data-lake-id="u7dcfe920" id="u7dcfe920">45</span></p></td><td data-lake-id="u6ecc3c17" id="u6ecc3c17"><p data-lake-id="uf4f81741" id="uf4f81741"><span data-lake-id="u9d55ab24" id="u9d55ab24">L2 → DCache</span></p></td><td data-lake-id="uaf9e8e2d" id="uaf9e8e2d"><p data-lake-id="u14a92fc0" id="u14a92fc0"><span data-lake-id="ubcc74a46" id="ubcc74a46">Snoop 地址；接收端补低位 0 后得到物理地址</span></p></td></tr><tr data-lake-id="u4a598d2f" id="u4a598d2f"><td data-lake-id="u684967d2" id="u684967d2"><p data-lake-id="u162f8ac1" id="u162f8ac1"><span data-lake-id="uead029b9" id="uead029b9">tagAlias</span></p></td><td data-lake-id="uf1907bc6" id="uf1907bc6"><p data-lake-id="u93499e7f" id="u93499e7f" style="text-align: right"><span data-lake-id="ufff8fc16" id="ufff8fc16">2</span></p></td><td data-lake-id="u09aa2310" id="u09aa2310"><p data-lake-id="u266c9227" id="u266c9227"><span data-lake-id="u15973a61" id="u15973a61">L2 → DCache</span></p></td><td data-lake-id="ubb86bce9" id="ubb86bce9"><p data-lake-id="u70b25750" id="u70b25750"><span data-lake-id="ue5c464ce" id="ue5c464ce">与物理地址拼接起来得到想无效化的set</span></p></td></tr><tr data-lake-id="ubfd66d3d" id="ubfd66d3d"><td data-lake-id="ub756d087" id="ub756d087"><p data-lake-id="uc9906b1f" id="uc9906b1f"><span data-lake-id="u0237e1ed" id="u0237e1ed">ns</span></p></td><td data-lake-id="uc220f3d2" id="uc220f3d2"><p data-lake-id="u2b2c8ec2" id="u2b2c8ec2" style="text-align: right"><span data-lake-id="u647b89ae" id="u647b89ae">1</span></p></td><td data-lake-id="u80d1223a" id="u80d1223a"><p data-lake-id="u22ff8184" id="u22ff8184"><span data-lake-id="uc634349e" id="uc634349e">L2 → DCache</span></p></td><td data-lake-id="u1d6e4335" id="u1d6e4335"><p data-lake-id="u9818966a" id="u9818966a"><span data-lake-id="u0ebe3751" id="u0ebe3751">secure/Nonsecure，固定填0</span></p></td></tr><tr data-lake-id="u3fc76f6d" id="u3fc76f6d"><td data-lake-id="ufc6055c3" id="ufc6055c3"><p data-lake-id="u40886460" id="u40886460"><span data-lake-id="uc1c1b905" id="uc1c1b905">traceTag</span></p></td><td data-lake-id="uc323ac11" id="uc323ac11"><p data-lake-id="u6054e13d" id="u6054e13d" style="text-align: right"><span data-lake-id="ua313ded1" id="ua313ded1">1</span></p></td><td data-lake-id="ue4fb0aa2" id="ue4fb0aa2"><p data-lake-id="u4fe03a57" id="u4fe03a57"><span data-lake-id="ud2ed2162" id="ud2ed2162">L2 → DCache</span></p></td><td data-lake-id="uf8e06e67" id="uf8e06e67"><p data-lake-id="ue145041d" id="ue145041d"><span data-lake-id="uab1bbecb" id="uab1bbecb">调试追踪标记</span></p></td></tr></tbody></table><p data-lake-id="ueb928466" id="ueb928466"><span data-lake-id="u0f8318ea" id="u0f8318ea">Snoop 的 </span><code data-lake-id="ub5c7c5a1" id="ub5c7c5a1"><span data-lake-id="ub629402a" id="ub629402a">txnId</span></code><span data-lake-id="ubcedc53c" id="ubcedc53c"> 属于 L2 的事务编号空间，不能与 DCache 自己发出的 TXREQ/TXEVT </span><code data-lake-id="u3d8480b9" id="u3d8480b9"><span data-lake-id="ue304c76e" id="ue304c76e">txnId</span></code><span data-lake-id="u4a3df82f" id="u4a3df82f"> 混用。收到匹配的 Snoop 时，L1 还要清除对应的 LR/SC reservation。</span></p><h2 data-lake-id="wl7Xr" id="wl7Xr"><span data-lake-id="uf4a773ef" id="uf4a773ef">6. TXRSP</span></h2><p data-lake-id="u47b8a2ab" id="u47b8a2ab"><span data-lake-id="u0b7c7552" id="u0b7c7552">payload 4 个，加上 </span><code data-lake-id="u8681656c" id="u8681656c"><span data-lake-id="ue7f84641" id="ue7f84641">valid/ready</span></code><span data-lake-id="u5b8d6190" id="u5b8d6190"> 后共 6 个信号。方向为 DCache → L2。</span></p><p data-lake-id="u6d283c3f" id="u6d283c3f"><span data-lake-id="u62f62ba6" id="u62f62ba6">DCache中的MissQueue和WriteBackQueue通过仲裁之后与L2Cache的TXEVT相联。</span></p><table data-lake-id="rZDhq" id="rZDhq" margin="true" class="lake-table" style="width: 547px"><colgroup><col width="97"><col width="61"><col width="122"><col width="267"></colgroup><tbody><tr data-lake-id="ufb7e18f0" id="ufb7e18f0"><td data-lake-id="u2b72fdc2" id="u2b72fdc2"><p data-lake-id="uc272dd6e" id="uc272dd6e"><span data-lake-id="u3d6f5f4f" id="u3d6f5f4f">字段</span></p></td><td data-lake-id="uaced592b" id="uaced592b"><p data-lake-id="uadaa69a1" id="uadaa69a1" style="text-align: right"><span data-lake-id="u42600073" id="u42600073">位宽</span></p></td><td data-lake-id="u4daf12f9" id="u4daf12f9"><p data-lake-id="ud39b82cf" id="ud39b82cf"><span data-lake-id="u13c440a7" id="u13c440a7">方向</span></p></td><td data-lake-id="uee7fcc02" id="uee7fcc02"><p data-lake-id="u46cf2a4f" id="u46cf2a4f"><span data-lake-id="ue9548fbb" id="ue9548fbb">DCache 中的主要用途</span></p></td></tr><tr data-lake-id="u15abf3d7" id="u15abf3d7"><td data-lake-id="uacda9367" id="uacda9367"><p data-lake-id="u5cc81c36" id="u5cc81c36"><span data-lake-id="u665313b4" id="u665313b4">txnId</span></p></td><td data-lake-id="u01fb3045" id="u01fb3045"><p data-lake-id="u8688ff20" id="u8688ff20" style="text-align: right"><span data-lake-id="u5f59ad7b" id="u5f59ad7b">8</span></p></td><td data-lake-id="u3920c5ff" id="u3920c5ff"><p data-lake-id="u911241d7" id="u911241d7"><span data-lake-id="u9a2e4960" id="u9a2e4960">DCache → L2</span></p></td><td data-lake-id="ua76af5d4" id="ua76af5d4"><p data-lake-id="u2a97f6c5" id="u2a97f6c5"><span data-lake-id="u2c4ea4ea" id="u2c4ea4ea">SnpResp 填收到的 Snoop TxnID；CompAck 填约定的完成事务 ID</span></p></td></tr><tr data-lake-id="ud5a20205" id="ud5a20205"><td data-lake-id="u75b4d3b4" id="u75b4d3b4"><p data-lake-id="ua73314bb" id="ua73314bb"><span data-lake-id="uf1e56dd3" id="uf1e56dd3">srcId</span></p></td><td data-lake-id="u46db5d07" id="u46db5d07"><p data-lake-id="u46b65c8a" id="u46b65c8a" style="text-align: right"><span data-lake-id="ub4dd54f2" id="ub4dd54f2">7</span></p></td><td data-lake-id="uc53186f4" id="uc53186f4"><p data-lake-id="uf08c9f54" id="uf08c9f54"><span data-lake-id="u7cf988e7" id="u7cf988e7">DCache → L2</span></p></td><td data-lake-id="u5899dbab" id="u5899dbab"><p data-lake-id="u30c148b9" id="u30c148b9"><span data-lake-id="u3589505d" id="u3589505d">响应来源节点，标识 DCache</span></p></td></tr><tr data-lake-id="uf76ca08f" id="uf76ca08f"><td data-lake-id="u1b5b9e0b" id="u1b5b9e0b"><p data-lake-id="u21b35acf" id="u21b35acf"><span data-lake-id="uef1f8f63" id="uef1f8f63">tgtId</span></p></td><td data-lake-id="u983f83d3" id="u983f83d3"><p data-lake-id="u338010b5" id="u338010b5" style="text-align: right"><span data-lake-id="u8314bbcc" id="u8314bbcc">7</span></p></td><td data-lake-id="u10a9aa56" id="u10a9aa56"><p data-lake-id="u95d1bec5" id="u95d1bec5"><span data-lake-id="u49ca6aaf" id="u49ca6aaf">DCache → L2</span></p></td><td data-lake-id="u37fbca58" id="u37fbca58"><p data-lake-id="u278bd729" id="u278bd729"><span data-lake-id="uab3ac1c2" id="uab3ac1c2">目标 L2 节点</span></p></td></tr><tr data-lake-id="u334c5aaa" id="u334c5aaa"><td data-lake-id="u37be5215" id="u37be5215"><p data-lake-id="u3886589b" id="u3886589b"><span data-lake-id="u92fa0616" id="u92fa0616">opcode</span></p></td><td data-lake-id="ua85025c2" id="ua85025c2"><p data-lake-id="u6607c72e" id="u6607c72e" style="text-align: right"><span data-lake-id="u8838be69" id="u8838be69">1</span></p></td><td data-lake-id="u1a30756f" id="u1a30756f"><p data-lake-id="u31d69faf" id="u31d69faf"><span data-lake-id="uc8fec1b2" id="uc8fec1b2">DCache → L2</span></p></td><td data-lake-id="u6ccf18ce" id="u6ccf18ce"><p data-lake-id="u4703cea3" id="u4703cea3"><span data-lake-id="ub9a4a9df" id="ub9a4a9df">0 表示 CompAck，1 表示无数据的 SnpResp</span></p></td></tr><tr data-lake-id="u107317fc" id="u107317fc"><td data-lake-id="u5549b6a3" id="u5549b6a3"><p data-lake-id="u1ccd997a" id="u1ccd997a"><span data-lake-id="u8c6c414b" id="u8c6c414b">respErr</span></p></td><td data-lake-id="u66857831" id="u66857831"><p data-lake-id="u2bd1f1d1" id="u2bd1f1d1" style="text-align: right"><span data-lake-id="u4c38c207" id="u4c38c207">2</span></p></td><td data-lake-id="u51134bac" id="u51134bac"><p data-lake-id="u475f7b15" id="u475f7b15"><span data-lake-id="uf6479b61" id="uf6479b61">DCache -&gt;L2</span></p></td><td data-lake-id="u7292ed30" id="u7292ed30"><p data-lake-id="u5d106318" id="u5d106318"><span data-lake-id="u534db272" id="u534db272">CompAck接收数据的错误</span></p></td></tr><tr data-lake-id="uc42de123" id="uc42de123"><td data-lake-id="u4dfe36ba" id="u4dfe36ba"><p data-lake-id="uc4817f0f" id="uc4817f0f"><span data-lake-id="uaa744eee" id="uaa744eee">resp</span></p></td><td data-lake-id="u1b8c226a" id="u1b8c226a"><p data-lake-id="ue56d083e" id="ue56d083e" style="text-align: right"><span data-lake-id="ua413a5f9" id="ua413a5f9">3</span></p></td><td data-lake-id="uce6ce91e" id="uce6ce91e"><p data-lake-id="udaece20a" id="udaece20a"><span data-lake-id="u75f8c749" id="u75f8c749">DCache → L2</span></p></td><td data-lake-id="u0eef0d60" id="u0eef0d60"><p data-lake-id="u7aa40108" id="u7aa40108"><span data-lake-id="u69f38b9d" id="u69f38b9d">报告 Snoop 后的缓存状态及 PassDirty 信息</span></p></td></tr><tr data-lake-id="uf0bd8397" id="uf0bd8397"><td data-lake-id="u5ed4f56e" id="u5ed4f56e"><p data-lake-id="u3aab6dd5" id="u3aab6dd5"><span data-lake-id="udb3b2551" id="udb3b2551">traceTag</span></p></td><td data-lake-id="u11d89bd0" id="u11d89bd0"><p data-lake-id="u98df1a73" id="u98df1a73" style="text-align: right"><span data-lake-id="u2a583850" id="u2a583850">1</span></p></td><td data-lake-id="u9e14da07" id="u9e14da07"><p data-lake-id="u73637d5b" id="u73637d5b"><span data-lake-id="u7d6f39c2" id="u7d6f39c2">DCache -&gt;L2</span></p></td><td data-lake-id="u81e60da5" id="u81e60da5"><p data-lake-id="u71c95b98" id="u71c95b98"><span data-lake-id="u812edd7d" id="u812edd7d">调试追踪标记</span></p></td></tr></tbody></table><p data-lake-id="u13334817" id="u13334817"><span data-lake-id="u2ad9eadc" id="u2ad9eadc">该通道不携带数据。需要返回数据的 Snoop 改走 TXDAT 的 </span><code data-lake-id="ud241ee18" id="ud241ee18"><span data-lake-id="uc91ed25e" id="uc91ed25e">SnpRespData</span></code><span data-lake-id="ue1203229" id="ue1203229">。</span></p><h2 data-lake-id="E0N1M" id="E0N1M"><span data-lake-id="u362f1ed0" id="u362f1ed0">7. TXDAT</span></h2><p data-lake-id="u0968b690" id="u0968b690"><span data-lake-id="uf33b0374" id="uf33b0374">payload 8 个，加上 </span><code data-lake-id="u958f82fd" id="u958f82fd"><span data-lake-id="uc0aeb3f0" id="uc0aeb3f0">valid/ready</span></code><span data-lake-id="u8b236b15" id="u8b236b15"> 后共 10 个信号。方向为 DCache → L2。</span></p><p data-lake-id="uffd55554" id="uffd55554"><span data-lake-id="u64935eb5" id="u64935eb5">DCache中的WriteBackQueue与L2Cache进行TXDAT相联。</span></p><table data-lake-id="ybktC" id="ybktC" margin="true" class="lake-table" style="width: 548px"><colgroup><col width="104"><col width="65"><col width="130"><col width="249"></colgroup><tbody><tr data-lake-id="ud13dbf70" id="ud13dbf70"><td data-lake-id="u6c132c46" id="u6c132c46"><p data-lake-id="uf6c6c6c9" id="uf6c6c6c9"><span data-lake-id="u4763d8ed" id="u4763d8ed">字段</span></p></td><td data-lake-id="u513a5c81" id="u513a5c81"><p data-lake-id="u98c2e558" id="u98c2e558" style="text-align: right"><span data-lake-id="u5ec863a5" id="u5ec863a5">位宽</span></p></td><td data-lake-id="u3197945b" id="u3197945b"><p data-lake-id="u01caaad4" id="u01caaad4"><span data-lake-id="u517e6175" id="u517e6175">方向</span></p></td><td data-lake-id="ue1b86af5" id="ue1b86af5"><p data-lake-id="uce888330" id="uce888330"><span data-lake-id="uca6cb9d7" id="uca6cb9d7">DCache 中的主要用途</span></p></td></tr><tr data-lake-id="uba1f5d20" id="uba1f5d20"><td data-lake-id="u66486227" id="u66486227"><p data-lake-id="uf442761e" id="uf442761e"><span data-lake-id="u80094d00" id="u80094d00">txnId</span></p></td><td data-lake-id="u79b58efd" id="u79b58efd"><p data-lake-id="u288f4aa0" id="u288f4aa0" style="text-align: right"><span data-lake-id="u723b9b92" id="u723b9b92">8</span></p></td><td data-lake-id="u81f55f84" id="u81f55f84"><p data-lake-id="u84091977" id="u84091977"><span data-lake-id="ub721a297" id="ub721a297">DCache → L2</span></p></td><td data-lake-id="ue9b0aba6" id="ue9b0aba6"><p data-lake-id="uf710aa92" id="uf710aa92"><span data-lake-id="ua427f4c2" id="ua427f4c2">写回数据填 DBID；Snoop 数据填收到的 Snoop TxnID</span></p></td></tr><tr data-lake-id="u9d99ea73" id="u9d99ea73"><td data-lake-id="u569c117b" id="u569c117b"><p data-lake-id="u8a4624e8" id="u8a4624e8"><span data-lake-id="ub89accbc" id="ub89accbc">srcId</span></p></td><td data-lake-id="ufbc1c9f7" id="ufbc1c9f7"><p data-lake-id="u67c6d0c7" id="u67c6d0c7" style="text-align: right"><span data-lake-id="ue5705e0e" id="ue5705e0e">7</span></p></td><td data-lake-id="u5768cf6a" id="u5768cf6a"><p data-lake-id="ufc045f85" id="ufc045f85"><span data-lake-id="u4a8c25be" id="u4a8c25be">DCache → L2</span></p></td><td data-lake-id="u32b02ca3" id="u32b02ca3"><p data-lake-id="uc1f65745" id="uc1f65745"><span data-lake-id="u16577156" id="u16577156">数据来源节点，标识 DCache</span></p></td></tr><tr data-lake-id="ubf47eae7" id="ubf47eae7"><td data-lake-id="u45694a12" id="u45694a12"><p data-lake-id="u6297640c" id="u6297640c"><span data-lake-id="u8be02090" id="u8be02090">tgtId</span></p></td><td data-lake-id="ud04e1100" id="ud04e1100"><p data-lake-id="u2146182c" id="u2146182c" style="text-align: right"><span data-lake-id="uab10bfbe" id="uab10bfbe">7</span></p></td><td data-lake-id="u87ed32ec" id="u87ed32ec"><p data-lake-id="u116bcfd0" id="u116bcfd0"><span data-lake-id="u2d32f7c8" id="u2d32f7c8">DCache → L2</span></p></td><td data-lake-id="u4c302008" id="u4c302008"><p data-lake-id="u51f37871" id="u51f37871"><span data-lake-id="u8cb3e15d" id="u8cb3e15d">目标 L2 节点</span></p></td></tr><tr data-lake-id="u930782ba" id="u930782ba"><td data-lake-id="uc058f4f6" id="uc058f4f6"><p data-lake-id="ub238aaec" id="ub238aaec"><span data-lake-id="u3c86ffb9" id="u3c86ffb9">opcode</span></p></td><td data-lake-id="ud0047cc7" id="ud0047cc7"><p data-lake-id="u5581dcbd" id="u5581dcbd" style="text-align: right"><span data-lake-id="u942cb33c" id="u942cb33c">2</span></p></td><td data-lake-id="u05be2d3c" id="u05be2d3c"><p data-lake-id="uffeaad0c" id="uffeaad0c"><span data-lake-id="u0ff542ab" id="u0ff542ab">DCache → L2</span></p></td><td data-lake-id="uf76a389e" id="uf76a389e"><p data-lake-id="u16809ad0" id="u16809ad0"><span data-lake-id="uccb54e56" id="uccb54e56">区分 CopyBackWrData、NonCopyBackWrData 和 SnpRespData</span></p></td></tr><tr data-lake-id="uaca31d74" id="uaca31d74"><td data-lake-id="ue4c20c10" id="ue4c20c10"><p data-lake-id="u81fd8495" id="u81fd8495"><span data-lake-id="u2b0313b1" id="u2b0313b1">respErr</span></p></td><td data-lake-id="ueb427b96" id="ueb427b96"><p data-lake-id="u4da2c0ab" id="u4da2c0ab" style="text-align: right"><span data-lake-id="ud8303a10" id="ud8303a10">2</span></p></td><td data-lake-id="u1fd0812e" id="u1fd0812e"><p data-lake-id="u66e07dd7" id="u66e07dd7"><span data-lake-id="ufa02ea46" id="ufa02ea46">DCache -&gt;L2</span></p></td><td data-lake-id="u1d56f924" id="u1d56f924"><p data-lake-id="u2b3f11e1" id="u2b3f11e1"><span data-lake-id="u58ffa3f1" id="u58ffa3f1">CompAck接收数据的错误</span></p></td></tr><tr data-lake-id="ua965e2b3" id="ua965e2b3"><td data-lake-id="uc2a92ed4" id="uc2a92ed4"><p data-lake-id="ub3399bbb" id="ub3399bbb"><span data-lake-id="ua4684cca" id="ua4684cca">resp</span></p></td><td data-lake-id="u857ed5a6" id="u857ed5a6"><p data-lake-id="u74d68d04" id="u74d68d04" style="text-align: right"><span data-lake-id="ud0780c70" id="ud0780c70">3</span></p></td><td data-lake-id="udd24ee83" id="udd24ee83"><p data-lake-id="u17db914b" id="u17db914b"><span data-lake-id="u4fe62d3e" id="u4fe62d3e">DCache → L2</span></p></td><td data-lake-id="ubd2f77ce" id="ubd2f77ce"><p data-lake-id="uff544156" id="uff544156"><span data-lake-id="u810fde29" id="u810fde29">报告写回或 Snoop 后的状态及脏责任转移</span></p></td></tr><tr data-lake-id="u58806cca" id="u58806cca"><td data-lake-id="u26ff41c0" id="u26ff41c0"><p data-lake-id="u68c5e2e5" id="u68c5e2e5"><span data-lake-id="u76b76358" id="u76b76358">dataId</span></p></td><td data-lake-id="u164892d9" id="u164892d9"><p data-lake-id="u9ea6e069" id="u9ea6e069" style="text-align: right"><span data-lake-id="u423e3be0" id="u423e3be0">1</span></p></td><td data-lake-id="u329fd1bc" id="u329fd1bc"><p data-lake-id="ub1e20f88" id="ub1e20f88"><span data-lake-id="u82eb0b64" id="u82eb0b64">DCache → L2</span></p></td><td data-lake-id="u73cc4b6c" id="u73cc4b6c"><p data-lake-id="uf2cb9d31" id="uf2cb9d31"><span data-lake-id="u07fac406" id="u07fac406">0 表示低 32B，1 表示高 32B</span></p></td></tr><tr data-lake-id="ubb9be3fd" id="ubb9be3fd"><td data-lake-id="u5335a435" id="u5335a435"><p data-lake-id="u11be7df9" id="u11be7df9"><span data-lake-id="u32136d8e" id="u32136d8e">data</span></p></td><td data-lake-id="u889e5ab0" id="u889e5ab0"><p data-lake-id="u100580ea" id="u100580ea" style="text-align: right"><span data-lake-id="u4c6fd8a4" id="u4c6fd8a4">256</span></p></td><td data-lake-id="u4fe84de3" id="u4fe84de3"><p data-lake-id="ua1bf01c9" id="ua1bf01c9"><span data-lake-id="u3082b49d" id="u3082b49d">DCache → L2</span></p></td><td data-lake-id="u4990d8c5" id="u4990d8c5"><p data-lake-id="u0f20edf3" id="u0f20edf3"><span data-lake-id="u2cc1f60e" id="u2cc1f60e">当前拍的数据</span></p></td></tr><tr data-lake-id="uba441969" id="uba441969"><td data-lake-id="u28781ff7" id="u28781ff7"><p data-lake-id="u34534edc" id="u34534edc"><span data-lake-id="uf6c8989a" id="uf6c8989a">byteEnable</span></p></td><td data-lake-id="uadc1496c" id="uadc1496c"><p data-lake-id="udb0c929d" id="udb0c929d" style="text-align: right"><span data-lake-id="u72b12f0c" id="u72b12f0c">8</span></p></td><td data-lake-id="u15bb2984" id="u15bb2984"><p data-lake-id="ufcb0d1de" id="ufcb0d1de"><span data-lake-id="ua9d9ff99" id="ua9d9ff99">DCache → L2</span></p></td><td data-lake-id="ude7751f3" id="ude7751f3"><p data-lake-id="ufe0c4a92" id="ufe0c4a92"><span data-lake-id="ua6e1f83e" id="ua6e1f83e">字有效</span></p></td></tr><tr data-lake-id="u2c0f1fad" id="u2c0f1fad"><td data-lake-id="u60cdf80a" id="u60cdf80a"><p data-lake-id="u3c0a9181" id="u3c0a9181"><span data-lake-id="ud3a48678" id="ud3a48678">traceTag</span></p></td><td data-lake-id="u4ba26eb6" id="u4ba26eb6"><p data-lake-id="ue643ee2b" id="ue643ee2b" style="text-align: right"><span data-lake-id="u6e94514e" id="u6e94514e">1</span></p></td><td data-lake-id="u52390930" id="u52390930"><p data-lake-id="u5f060b96" id="u5f060b96"><span data-lake-id="uee642671" id="uee642671">DCache → L2</span></p></td><td data-lake-id="u3aae3c2b" id="u3aae3c2b"><p data-lake-id="ufe4cb286" id="ufe4cb286"><span data-lake-id="u9de0b349" id="u9de0b349">调试追踪标记，不影响数据内容</span></p></td></tr></tbody></table><p data-lake-id="uc6315ca4" id="uc6315ca4"><span data-lake-id="ufeedf3b0" id="ufeedf3b0">64B cache line 在 256 bit 数据宽度下需要两拍。数据必须按 </span><code data-lake-id="u488f7caf" id="u488f7caf"><span data-lake-id="ue8f21f00" id="ue8f21f00">dataId</span></code><span data-lake-id="u3e85a5aa" id="u3e85a5aa"> 定位，不能默认两拍一定按 0、1 顺序传输。</span></p><h2 data-lake-id="TXnua" id="TXnua"><span data-lake-id="uce05936c" id="uce05936c">8. RXRSP</span></h2><p data-lake-id="u119cfb5c" id="u119cfb5c"><span data-lake-id="u4eb2db97" id="u4eb2db97">payload 8 个，加上 </span><code data-lake-id="u86710d51" id="u86710d51"><span data-lake-id="u9056cd71" id="u9056cd71">valid/ready</span></code><span data-lake-id="ue562e99b" id="ue562e99b"> 后共 10 个信号。方向为 L2 → DCache。</span></p><p data-lake-id="ud62a8318" id="ud62a8318"><span data-lake-id="ude105fd2" id="ude105fd2">DCache中的MissQueue和WriteBackQueue通过txnID辨别方向之后与L2Cache的RXRSP相联。</span></p><table data-lake-id="rLotK" id="rLotK" margin="true" class="lake-table" style="width: 543px"><colgroup><col width="97"><col width="59"><col width="117"><col width="270"></colgroup><tbody><tr data-lake-id="u37a732a7" id="u37a732a7"><td data-lake-id="u6866379b" id="u6866379b"><p data-lake-id="u2a94fffd" id="u2a94fffd"><span data-lake-id="u37b39d02" id="u37b39d02">字段</span></p></td><td data-lake-id="ud8efc1e5" id="ud8efc1e5"><p data-lake-id="u84309b86" id="u84309b86" style="text-align: right"><span data-lake-id="ub182e7b0" id="ub182e7b0">位宽</span></p></td><td data-lake-id="uce086246" id="uce086246"><p data-lake-id="ufcae8395" id="ufcae8395"><span data-lake-id="ud6c73c9f" id="ud6c73c9f">方向</span></p></td><td data-lake-id="u1a3969b2" id="u1a3969b2"><p data-lake-id="uc74f50db" id="uc74f50db"><span data-lake-id="ucb4652b8" id="ucb4652b8">DCache 中的主要用途</span></p></td></tr><tr data-lake-id="ue76f75af" id="ue76f75af"><td data-lake-id="ue78b2692" id="ue78b2692"><p data-lake-id="ub3ba117e" id="ub3ba117e"><span data-lake-id="u720364c6" id="u720364c6">txnId</span></p></td><td data-lake-id="u306c65f4" id="u306c65f4"><p data-lake-id="uf904a9bf" id="uf904a9bf" style="text-align: right"><span data-lake-id="u4f9a473c" id="u4f9a473c">8</span></p></td><td data-lake-id="u0baae729" id="u0baae729"><p data-lake-id="u321215b4" id="u321215b4"><span data-lake-id="u1359504b" id="u1359504b">L2 → DCache</span></p></td><td data-lake-id="ue46fedc7" id="ue46fedc7"><p data-lake-id="u260d8dd4" id="u260d8dd4"><span data-lake-id="u87231d1c" id="u87231d1c">原始 TXREQ 或 TXEVT 的事务 ID，用于找回 MSHR、WBQ 或 CMO</span></p></td></tr><tr data-lake-id="u368521b6" id="u368521b6"><td data-lake-id="u63faaef9" id="u63faaef9"><p data-lake-id="ub707e61c" id="ub707e61c"><span data-lake-id="ue6de6d93" id="ue6de6d93">srcId</span></p></td><td data-lake-id="u3e3eccc4" id="u3e3eccc4"><p data-lake-id="u97e5aa03" id="u97e5aa03" style="text-align: right"><span data-lake-id="u8ab4e3a1" id="u8ab4e3a1">7</span></p></td><td data-lake-id="u6240c672" id="u6240c672"><p data-lake-id="uafa04b5b" id="uafa04b5b"><span data-lake-id="u2390bb0c" id="u2390bb0c">L2 → DCache</span></p></td><td data-lake-id="u11c44ba0" id="u11c44ba0"><p data-lake-id="u5ab641f9" id="u5ab641f9"><span data-lake-id="uc7307d90" id="uc7307d90">响应来源 L2 节点</span></p></td></tr><tr data-lake-id="u884a391c" id="u884a391c"><td data-lake-id="u5b2200ab" id="u5b2200ab"><p data-lake-id="u35477247" id="u35477247"><span data-lake-id="u4824e43b" id="u4824e43b">tgtId</span></p></td><td data-lake-id="u6c7df7b2" id="u6c7df7b2"><p data-lake-id="u740a1713" id="u740a1713" style="text-align: right"><span data-lake-id="uf371faf7" id="uf371faf7">7</span></p></td><td data-lake-id="u0ef584a1" id="u0ef584a1"><p data-lake-id="udadf16a4" id="udadf16a4"><span data-lake-id="u5ecb3a7f" id="u5ecb3a7f">L2 → DCache</span></p></td><td data-lake-id="u6db69471" id="u6db69471"><p data-lake-id="u5d919cb2" id="u5d919cb2"><span data-lake-id="u20494e65" id="u20494e65">响应目标上游节点，用于确认是否发给本 DCache</span></p></td></tr><tr data-lake-id="u943c7607" id="u943c7607"><td data-lake-id="ufea204d3" id="ufea204d3"><p data-lake-id="u1e656519" id="u1e656519"><span data-lake-id="u78901094" id="u78901094">dbId</span></p></td><td data-lake-id="u9a9225e6" id="u9a9225e6"><p data-lake-id="uc93ebdec" id="uc93ebdec" style="text-align: right"><span data-lake-id="u4a2f4b1f" id="u4a2f4b1f">8</span></p></td><td data-lake-id="uf2fd3489" id="uf2fd3489"><p data-lake-id="u071992cf" id="u071992cf"><span data-lake-id="u4222c9b7" id="u4222c9b7">L2 → DCache</span></p></td><td data-lake-id="u827f6de9" id="u827f6de9"><p data-lake-id="u70f7bf78" id="u70f7bf78"><span data-lake-id="ub4d9d1d0" id="ub4d9d1d0">L2 分配的数据缓冲 ID；写回时后续 TXDAT 必须使用它</span></p></td></tr><tr data-lake-id="ueda04912" id="ueda04912"><td data-lake-id="u8103877e" id="u8103877e"><p data-lake-id="uf02f722e" id="uf02f722e"><span data-lake-id="u2e750cdd" id="u2e750cdd">opcode</span></p></td><td data-lake-id="udb665339" id="udb665339"><p data-lake-id="u53a23366" id="u53a23366" style="text-align: right"><span data-lake-id="ucc44a89d" id="ucc44a89d">3</span></p></td><td data-lake-id="u1d00cb43" id="u1d00cb43"><p data-lake-id="u8d2f683f" id="u8d2f683f"><span data-lake-id="u980d84ef" id="u980d84ef">L2 → DCache</span></p></td><td data-lake-id="udce66fe8" id="udce66fe8"><p data-lake-id="u02d1ebff" id="u02d1ebff"><span data-lake-id="ucb418ef4" id="ucb418ef4">区分 Comp、DBIDResp、CompDBIDResp、CompCMO 等完成消息</span></p></td></tr><tr data-lake-id="u682eaedf" id="u682eaedf"><td data-lake-id="u7e015d63" id="u7e015d63"><p data-lake-id="ud6e0825b" id="ud6e0825b"><span data-lake-id="udb53fd99" id="udb53fd99">resp</span></p></td><td data-lake-id="uf6f348db" id="uf6f348db"><p data-lake-id="u923aa509" id="u923aa509" style="text-align: right"><span data-lake-id="u68ee11f5" id="u68ee11f5">3</span></p></td><td data-lake-id="uc500566d" id="uc500566d"><p data-lake-id="u29a0eb95" id="u29a0eb95"><span data-lake-id="u7894eda4" id="u7894eda4">L2 → DCache</span></p></td><td data-lake-id="u444c634f" id="u444c634f"><p data-lake-id="udd8e5977" id="udd8e5977"><span data-lake-id="u659c7688" id="u659c7688">返回授予的缓存状态或 PassDirty 信息</span></p></td></tr><tr data-lake-id="u94e52b0d" id="u94e52b0d" style="height: 36px"><td data-lake-id="ubc9616a9" id="ubc9616a9"><p data-lake-id="u3e945d2b" id="u3e945d2b"><span data-lake-id="u64a41dcc" id="u64a41dcc">cBusy</span></p></td><td data-lake-id="u2c811369" id="u2c811369"><p data-lake-id="u4424993d" id="u4424993d" style="text-align: right"><span data-lake-id="u44293ec7" id="u44293ec7">3</span></p></td><td data-lake-id="ud01e38ab" id="ud01e38ab"><p data-lake-id="ub03a6114" id="ub03a6114"><span data-lake-id="u731e3fec" id="u731e3fec">L2 → DCache</span></p></td><td data-lake-id="ud6cc2fa8" id="ud6cc2fa8"><p data-lake-id="ua0b2747e" id="ua0b2747e"><span data-lake-id="uc59ce66d" id="uc59ce66d">L2忙提示，固定填0.</span></p></td></tr><tr data-lake-id="u8757dedf" id="u8757dedf"><td data-lake-id="uefe5b608" id="uefe5b608"><p data-lake-id="ud074bcd7" id="ud074bcd7"><span data-lake-id="u605402a2" id="u605402a2">traceTag</span></p></td><td data-lake-id="u8ef0d305" id="u8ef0d305"><p data-lake-id="uec4fae33" id="uec4fae33" style="text-align: right"><span data-lake-id="u3fe2fac6" id="u3fe2fac6">1</span></p></td><td data-lake-id="ue6548c83" id="ue6548c83"><p data-lake-id="u62b564bb" id="u62b564bb"><span data-lake-id="u9dc20faf" id="u9dc20faf">L2 → DCache</span></p></td><td data-lake-id="u6e7ee2d4" id="u6e7ee2d4"><p data-lake-id="ubbdb2687" id="ubbdb2687"><span data-lake-id="ued1666d5" id="ued1666d5">调试追踪标记，不影响事务完成判断</span></p></td></tr></tbody></table><p data-lake-id="u9f80de3c" id="u9f80de3c"><code data-lake-id="u2684f116" id="u2684f116"><span data-lake-id="u340c7334" id="u340c7334">DBIDResp</span></code><span data-lake-id="u06a81492" id="u06a81492"> 只表示可以发送写回数据，不表示写回事务已经全部完成。</span><code data-lake-id="u24212339" id="u24212339"><span data-lake-id="u8dfe6555" id="u8dfe6555">CompCMO</span></code><span data-lake-id="u323773d4" id="u323773d4"> 也不能当成普通 </span><code data-lake-id="u8344eeae" id="u8344eeae"><span data-lake-id="u44dbbcfd" id="u44dbbcfd">Comp</span></code><span data-lake-id="u25ac75c0" id="u25ac75c0"> 处理。</span></p><h2 data-lake-id="ezgEr" id="ezgEr"><span data-lake-id="uc860c253" id="uc860c253">9. RXDAT</span></h2><p data-lake-id="u7e39855c" id="u7e39855c"><span data-lake-id="ue97989ce" id="ue97989ce">payload 8 个，加上 </span><code data-lake-id="u104167fe" id="u104167fe"><span data-lake-id="u9f0a8d84" id="u9f0a8d84">valid/ready</span></code><span data-lake-id="ub4d3a7fe" id="ub4d3a7fe"> 后共 10 个信号。方向为 L2 → DCache。</span></p><p data-lake-id="u62d0841e" id="u62d0841e"><span data-lake-id="uea2b614b" id="uea2b614b">DCache中的MissQueue部件与L2Cache通过RXDAT相联。</span></p><table data-lake-id="oCECn" id="oCECn" margin="true" class="lake-table" style="width: 576px"><colgroup><col width="91"><col width="56"><col width="123"><col width="306"></colgroup><tbody><tr data-lake-id="uee38e482" id="uee38e482"><td data-lake-id="ue4ff771b" id="ue4ff771b"><p data-lake-id="u17a795a5" id="u17a795a5"><span data-lake-id="ub562c9af" id="ub562c9af">字段</span></p></td><td data-lake-id="uc51d5f33" id="uc51d5f33"><p data-lake-id="ueda13bf5" id="ueda13bf5" style="text-align: right"><span data-lake-id="ubb25561e" id="ubb25561e">位宽</span></p></td><td data-lake-id="uc8143813" id="uc8143813"><p data-lake-id="u9da98ca9" id="u9da98ca9"><span data-lake-id="u7042e953" id="u7042e953">方向</span></p></td><td data-lake-id="ub68fa56b" id="ub68fa56b"><p data-lake-id="u94d95e47" id="u94d95e47"><span data-lake-id="ueb00e65c" id="ueb00e65c">DCache 中的主要用途</span></p></td></tr><tr data-lake-id="udc6863a1" id="udc6863a1"><td data-lake-id="u507c05b1" id="u507c05b1"><p data-lake-id="u372cb996" id="u372cb996"><span data-lake-id="u08a494b9" id="u08a494b9">txnId</span></p></td><td data-lake-id="ub59b838c" id="ub59b838c"><p data-lake-id="u3f1dc9a7" id="u3f1dc9a7" style="text-align: right"><span data-lake-id="uc2ea571f" id="uc2ea571f">8</span></p></td><td data-lake-id="u6faf1364" id="u6faf1364"><p data-lake-id="u85db293b" id="u85db293b"><span data-lake-id="u53ea712f" id="u53ea712f">L2 → DCache</span></p></td><td data-lake-id="u046a10bf" id="u046a10bf"><p data-lake-id="ud4a00aaa" id="ud4a00aaa"><span data-lake-id="ue723be30" id="ue723be30">原始读请求事务 ID，用于找回对应 MSHR</span></p></td></tr><tr data-lake-id="uddeb63ce" id="uddeb63ce"><td data-lake-id="u725ad420" id="u725ad420"><p data-lake-id="u1cc75c59" id="u1cc75c59"><span data-lake-id="u4d5f3467" id="u4d5f3467">srcId</span></p></td><td data-lake-id="u70ef7d7b" id="u70ef7d7b"><p data-lake-id="ubeca3c23" id="ubeca3c23" style="text-align: right"><span data-lake-id="uaffa73db" id="uaffa73db">7</span></p></td><td data-lake-id="ua52e1d69" id="ua52e1d69"><p data-lake-id="u6ddcf404" id="u6ddcf404"><span data-lake-id="uf00adf3a" id="uf00adf3a">L2 → DCache</span></p></td><td data-lake-id="u4c33c886" id="u4c33c886"><p data-lake-id="uf112a4b3" id="uf112a4b3"><span data-lake-id="u245b7be4" id="u245b7be4">数据来源 L2 节点</span></p></td></tr><tr data-lake-id="u7ea75fa0" id="u7ea75fa0"><td data-lake-id="u5e21e453" id="u5e21e453"><p data-lake-id="u6b7ba957" id="u6b7ba957"><span data-lake-id="ue89fa2b1" id="ue89fa2b1">tgtId</span></p></td><td data-lake-id="u39a49d63" id="u39a49d63"><p data-lake-id="ucc464e18" id="ucc464e18" style="text-align: right"><span data-lake-id="u1badf71c" id="u1badf71c">7</span></p></td><td data-lake-id="u81887882" id="u81887882"><p data-lake-id="u0f2e36a2" id="u0f2e36a2"><span data-lake-id="ue6cb9aa0" id="ue6cb9aa0">L2 → DCache</span></p></td><td data-lake-id="u2c73b911" id="u2c73b911"><p data-lake-id="u03105291" id="u03105291"><span data-lake-id="uc2c18a0c" id="uc2c18a0c">数据目标上游节点，用于确认是否发给本 DCache</span></p></td></tr><tr data-lake-id="u4c980b9f" id="u4c980b9f"><td data-lake-id="u694d0a56" id="u694d0a56"><p data-lake-id="u7822c048" id="u7822c048"><span data-lake-id="u54b0f7c8" id="u54b0f7c8">dbId</span></p></td><td data-lake-id="ue375cb4b" id="ue375cb4b"><p data-lake-id="ub8fccf7c" id="ub8fccf7c" style="text-align: right"><span data-lake-id="u88fa797b" id="u88fa797b">8</span></p></td><td data-lake-id="u528d8dba" id="u528d8dba"><p data-lake-id="ud5b90b04" id="ud5b90b04"><span data-lake-id="u1691f616" id="u1691f616">L2 → DCache</span></p></td><td data-lake-id="ufafb63f5" id="ufafb63f5"><p data-lake-id="u17974d88" id="u17974d88"><span data-lake-id="u75c52e35" id="u75c52e35">随数据返回的 DBID，供后续 CompAck 关联使用</span></p></td></tr><tr data-lake-id="u79e3f04d" id="u79e3f04d" style="height: 36px"><td data-lake-id="ubfc4c903" id="ubfc4c903"><p data-lake-id="u056b35ac" id="u056b35ac"><span data-lake-id="u06f96b1f" id="u06f96b1f">opcode</span></p></td><td data-lake-id="u4257bc24" id="u4257bc24"><p data-lake-id="ubbd2da54" id="ubbd2da54" style="text-align: right"><span data-lake-id="uc7000057" id="uc7000057">1</span></p></td><td data-lake-id="u4fe9930d" id="u4fe9930d"><p data-lake-id="uc53fb7eb" id="uc53fb7eb"><span data-lake-id="u78f6e823" id="u78f6e823">L2 → DCache</span></p></td><td data-lake-id="ua88332ff" id="ua88332ff"><p data-lake-id="ub68ce940" id="ub68ce940"><span data-lake-id="u6b72b1a3" id="u6b72b1a3">下游DAT只有CompData</span></p></td></tr><tr data-lake-id="u696bd37d" id="u696bd37d" style="height: 36px"><td data-lake-id="u95a278f6" id="u95a278f6"><p data-lake-id="u90632274" id="u90632274"><span data-lake-id="u1cfbbc8f" id="u1cfbbc8f">respErr</span></p></td><td data-lake-id="u8837e80e" id="u8837e80e"><p data-lake-id="u863b6484" id="u863b6484" style="text-align: right"><span data-lake-id="u713438a4" id="u713438a4">3</span></p></td><td data-lake-id="uc509389b" id="uc509389b"><p data-lake-id="u2ef1c765" id="u2ef1c765"><span data-lake-id="u4cf1f135" id="u4cf1f135">L2 → DCache</span></p></td><td data-lake-id="u374141a5" id="u374141a5"><p data-lake-id="uae4f9e27" id="uae4f9e27"><span data-lake-id="ue3789b8b" id="ue3789b8b">CompAck接收数据的错误</span></p></td></tr><tr data-lake-id="ue743cffa" id="ue743cffa"><td data-lake-id="ubdf3e4b0" id="ubdf3e4b0"><p data-lake-id="u56cf5669" id="u56cf5669"><span data-lake-id="u881febf2" id="u881febf2">resp</span></p></td><td data-lake-id="u8acd4171" id="u8acd4171"><p data-lake-id="u292dad55" id="u292dad55" style="text-align: right"><span data-lake-id="u7040723f" id="u7040723f">3</span></p></td><td data-lake-id="u5a4049c1" id="u5a4049c1"><p data-lake-id="u6e58dec3" id="u6e58dec3"><span data-lake-id="ub92bc1f6" id="ub92bc1f6">L2 → DCache</span></p></td><td data-lake-id="ud976c3ad" id="ud976c3ad"><p data-lake-id="u791f98c5" id="u791f98c5"><span data-lake-id="u86e0ef85" id="u86e0ef85">返回 cache line 应进入的一致性状态及脏责任</span></p></td></tr><tr data-lake-id="uc510a36a" id="uc510a36a"><td data-lake-id="ucec7e0b3" id="ucec7e0b3"><p data-lake-id="u7040ed40" id="u7040ed40"><span data-lake-id="u646d3d93" id="u646d3d93">data Source</span></p></td><td data-lake-id="uac4b44a3" id="uac4b44a3"><p data-lake-id="u1e4110d6" id="u1e4110d6" style="text-align: right"><span data-lake-id="u6cded36a" id="u6cded36a">5</span></p></td><td data-lake-id="uc05f99bd" id="uc05f99bd"><p data-lake-id="u6bee39bc" id="u6bee39bc"><span data-lake-id="u25e31bb4" id="u25e31bb4">L2 → DCache</span></p></td><td data-lake-id="u54958edb" id="u54958edb"><p data-lake-id="u8502ff33" id="u8502ff33"><span data-lake-id="u563fb0a5" id="u563fb0a5">L2从哪里取数据。这里可以硬连线0</span></p></td></tr><tr data-lake-id="u0c5ae899" id="u0c5ae899"><td data-lake-id="u71e6fc6e" id="u71e6fc6e"><p data-lake-id="uce9a6ebc" id="uce9a6ebc"><span data-lake-id="u9a1293fe" id="u9a1293fe">cBusy</span></p></td><td data-lake-id="ua804756c" id="ua804756c"><p data-lake-id="