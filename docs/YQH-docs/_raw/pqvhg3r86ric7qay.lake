e6647" id="u581e6647"><p data-lake-id="ufb4000c0" id="ufb4000c0" style="text-align: left"><span data-lake-id="ucb03d143" id="ucb03d143" class="lake-fontsize-10">miss/replace</span></p></td><td data-lake-id="u62754045" id="u62754045"><p data-lake-id="ue670b3c9" id="ue670b3c9" style="text-align: left"><span data-lake-id="ue478c748" id="ue478c748" class="lake-fontsize-10">脏，带数据</span></p></td><td data-lake-id="u5dafd6f5" id="u5dafd6f5"><p data-lake-id="udf8e5b39" id="udf8e5b39" style="text-align: left"><code data-lake-id="udefecd8b" id="udefecd8b"><span data-lake-id="u877bd344" id="u877bd344" class="lake-fontsize-9">WriteBackFull</span></code></p></td></tr><tr data-lake-id="u6fb03e3a" id="u6fb03e3a"><td data-lake-id="u56c0ecad" id="u56c0ecad"><p data-lake-id="ubd07029d" id="ubd07029d" style="text-align: left"><span data-lake-id="uc60bb8f0" id="uc60bb8f0" class="lake-fontsize-10">miss/replace</span></p></td><td data-lake-id="u76e565ce" id="u76e565ce"><p data-lake-id="u0c48dff4" id="u0c48dff4" style="text-align: left"><span data-lake-id="uc9f0b6df" id="uc9f0b6df" class="lake-fontsize-10">干净，不带数据</span></p></td><td data-lake-id="u0c3729ae" id="u0c3729ae"><p data-lake-id="uc8404954" id="uc8404954" style="text-align: left"><code data-lake-id="u21377b68" id="u21377b68"><span data-lake-id="ua0199850" id="ua0199850" class="lake-fontsize-9">Evict</span></code></p></td></tr><tr data-lake-id="ufebf8f69" id="ufebf8f69"><td data-lake-id="uf29e2b9c" id="uf29e2b9c"><p data-lake-id="u57eb4e92" id="u57eb4e92" style="text-align: left"><span data-lake-id="uf5ff0503" id="uf5ff0503" class="lake-fontsize-10">miss/replace</span></p></td><td data-lake-id="uff9f986e" id="uff9f986e"><p data-lake-id="u4cd505a0" id="u4cd505a0" style="text-align: left"><span data-lake-id="ubd8e3126" id="ubd8e3126" class="lake-fontsize-10">干净，但仍带数据（只有打开 </span><code data-lake-id="u6f3625e2" id="u6f3625e2"><span data-lake-id="u5d0724d2" id="u5d0724d2" class="lake-fontsize-9">alwaysReleaseData</span></code><span data-lake-id="u7b68029e" id="u7b68029e" class="lake-fontsize-10">）</span></p></td><td data-lake-id="ue5301e9b" id="ue5301e9b"><p data-lake-id="ucb3552c9" id="ucb3552c9" style="text-align: left"><code data-lake-id="udcdd2976" id="udcdd2976"><span data-lake-id="u3fc1f1b2" id="u3fc1f1b2" class="lake-fontsize-9">WriteEvictFull</span></code></p></td></tr><tr data-lake-id="uba520e29" id="uba520e29"><td data-lake-id="ue723ef5e" id="ue723ef5e"><p data-lake-id="u08f0d658" id="u08f0d658" style="text-align: left"><span data-lake-id="u51cda114" id="u51cda114" class="lake-fontsize-10">probe</span></p></td><td data-lake-id="ub2ea2340" id="ub2ea2340"><p data-lake-id="uc97acb6c" id="uc97acb6c" style="text-align: left"><span data-lake-id="uc9bbc33c" id="uc9bbc33c" class="lake-fontsize-10">不带数据</span></p></td><td data-lake-id="u9d61661e" id="u9d61661e"><p data-lake-id="u2e6c82e2" id="u2e6c82e2" style="text-align: left"><code data-lake-id="ue201a5c7" id="ue201a5c7"><span data-lake-id="u2d80e98e" id="u2d80e98e" class="lake-fontsize-9">SnpResp</span></code></p></td></tr><tr data-lake-id="u40d4da7d" id="u40d4da7d"><td data-lake-id="u25c59250" id="u25c59250"><p data-lake-id="u71e13fc2" id="u71e13fc2" style="text-align: left"><span data-lake-id="u8c5618cd" id="u8c5618cd" class="lake-fontsize-10">probe</span></p></td><td data-lake-id="u6c9fa37a" id="u6c9fa37a"><p data-lake-id="u39d45bfc" id="u39d45bfc" style="text-align: left"><span data-lake-id="u60e17fbb" id="u60e17fbb" class="lake-fontsize-10">带数据</span></p></td><td data-lake-id="uad384698" id="uad384698"><p data-lake-id="u947a9487" id="u947a9487" style="text-align: left"><code data-lake-id="uc8a17d7c" id="uc8a17d7c"><span data-lake-id="ub17250f0" id="ub17250f0" class="lake-fontsize-9">SnpRespData</span></code></p></td></tr></tbody></table><h2 data-lake-id="jp3Yv" id="jp3Yv"><span data-lake-id="u4f6e14b7" id="u4f6e14b7">事务描述</span></h2><h3 data-lake-id="FYCtl" id="FYCtl"><span data-lake-id="ufd0b8380" id="ufd0b8380">干净 victim：Evict</span></h3><p data-lake-id="u828b5b1f" id="u828b5b1f"><span data-lake-id="u3897434a" id="u3897434a">refill 的 s3 发现旧行是 SC 或 UC。</span></p><ol list="u16da811f"><li fid="uceeb4993" data-lake-id="uf1caea37" id="uf1caea37"><span data-lake-id="udd203375" id="udd203375">s3 把无数据请求交进一个空项。同时才能把新行写入这个 way。</span></li><li fid="uceeb4993" data-lake-id="u60354675" id="u60354675"><span data-lake-id="u452f6a11" id="u452f6a11">项发 TXEVT，opcode=0，txnId=17+项号，地址是旧行的物理地址。</span></li><li fid="uceeb4993" data-lake-id="u5a45dea7" id="u5a45dea7"><span data-lake-id="u8abd1fb9" id="u8abd1fb9">L2 收下之后等 RXRSP。Comp 或 CompDBIDResp 里的完成到达后，项释放。</span></li><li fid="uceeb4993" data-lake-id="uf2915bd0" id="uf2915bd0"><span data-lake-id="u6e521c12" id="u6e521c12">不发 TXDAT。即使响应里带着 dbId，也不使用。</span></li></ol><p data-lake-id="ud54b999a" id="ud54b999a"><span data-lake-id="u0ff5a84a" id="u0ff5a84a">不能把 UD 先改成 SC 再走这条路径。那样脏数据就没有副本了。</span></p><h3 data-lake-id="bY8sc" id="bY8sc"><span data-lake-id="u32e42356" id="u32e42356">脏 victim：WriteBackFull</span></h3><p data-lake-id="ub855cd63" id="ub855cd63"><span data-lake-id="u33fd6165" id="u33fd6165">旧行是 UD。</span></p><ol list="ub77da804"><li fid="uc29a072b" data-lake-id="u26be1fe5" id="u26be1fe5"><span data-lake-id="u24aaeeb3" id="u24aaeeb3">s3 先把 64B 和地址交进队列，再写新行。队列没 ready，s3 停住，旧行还留在 Array 里。</span></li><li fid="uc29a072b" data-lake-id="u8943db3c" id="u8943db3c"><span data-lake-id="ue4175cfc" id="ue4175cfc">数据晚一拍写入项。然后发 TXEVT，opcode=1。</span></li><li fid="uc29a072b" data-lake-id="uda4e163b" id="uda4e163b"><span data-lake-id="u98d762ec" id="u98d762ec">等到 DBIDResp 或 CompDBIDResp，得到 dbId。在这之前 TXDAT 不能发。</span></li><li fid="uc29a072b" data-lake-id="u65f0a0ae" id="u65f0a0ae"><span data-lake-id="u6f8fac62" id="u6f8fac62">TXDAT 发两拍 CopyBackWrData。txnId 填 dbId，不是 17+项号。先 </span><code data-lake-id="ubf54cb4c" id="ubf54cb4c"><span data-lake-id="ue3e0fd28" id="ue3e0fd28">dataId=0</span></code><span data-lake-id="u6c2501fd" id="u6c2501fd">，再 </span><code data-lake-id="uc3e89860" id="uc3e89860"><span data-lake-id="u7dd0b856" id="u7dd0b856">dataId=1</span></code><span data-lake-id="u59fe6472" id="u59fe6472">。两拍的 opcode、resp、txnId 必须相同。</span></li><li fid="uc29a072b" data-lake-id="uf6e7865c" id="uf6e7865c"><span data-lake-id="ub664934f" id="ub664934f">数据发完，并且完成已经到达，项才释放。DBIDResp 单独到达不算完成。</span></li></ol><p data-lake-id="u61715230" id="u61715230"><span data-lake-id="u1886a116" id="u1886a116">Resp 表示脏数据已经交出，写回事务的最终状态是 I。不要因为发出了数据就把本地 Tag 写成 UC。本地这个 way 的新状态由同一次 refill 安装，和这项无关。</span></p><h3 data-lake-id="urgHU" id="urgHU"><span data-lake-id="uce8c7dbc" id="uce8c7dbc">Snoop 无数据</span></h3><p data-lake-id="uc8657367" id="uc8657367"><span data-lake-id="ua1f2b17f" id="ua1f2b17f">MainPipe s3 已经改好 Meta，交来一个 </span><code data-lake-id="u08090230" id="u08090230"><span data-lake-id="ucceea33f" id="ucceea33f">hasData=0</span></code><span data-lake-id="ue3b28525" id="ue3b28525"> 的 snoop 请求。</span></p><ol list="u2d498b6b"><li fid="u83ff1eb5" data-lake-id="udfaae0f1" id="udfaae0f1"><span data-lake-id="u4e30bc95" id="u4e30bc95">项直接准备 TXRSP，opcode=1。txnId 填原来的 Snoop 编号。resp 填 I、SC 或 UC。</span></li><li fid="u83ff1eb5" data-lake-id="u3ce1201e" id="u3ce1201e"><span data-lake-id="ub9c96b99" id="ub9c96b99">边界仲裁赢了并且 L2 ready 收下，下一拍项释放。</span></li><li fid="u83ff1eb5" data-lake-id="u71aeb2c0" id="u71aeb2c0"><span data-lake-id="u95b658b6" id="u95b658b6">不等 RXRSP，也不发 TXEVT。</span></li></ol><p data-lake-id="u97b14fc8" id="u97b14fc8"><span data-lake-id="ud75815d0" id="ud75815d0">miss 的 Snoop 也走这里，resp 为 I。</span></p><h3 data-lake-id="stGLI" id="stGLI"><span data-lake-id="u429c2bb1" id="u429c2bb1">Snoop 有数据</span></h3><p data-lake-id="uf6e227d0" id="uf6e227d0"><span data-lake-id="u9c5f2902" id="u9c5f2902">原来是 UD，或者对方要求数据。</span></p><ol list="ua403d998"><li fid="uc84a5f3c" data-lake-id="u0a054a5f" id="u0a054a5f"><span data-lake-id="u83a6c53d" id="u83a6c53d">64B 同样晚一拍写入。</span></li><li fid="uc84a5f3c" data-lake-id="ud8c204c8" id="ud8c204c8"><span data-lake-id="u46f7355c" id="u46f7355c">不发 TXEVT。两拍都走 TXDAT，opcode 为 SnpRespData。txnId 填 Snoop 编号，不填 dbId。</span></li><li fid="uc84a5f3c" data-lake-id="u66e94cac" id="u66e94cac"><span data-lake-id="ub3c3885d" id="ub3c3885d">两拍都被收下后释放。不等 RXRSP。</span></li><li fid="uc84a5f3c" data-lake-id="u056641af" id="u056641af"><span data-lake-id="uac5d7859" id="uac5d7859">脏责任一起交出时，resp 要带上 PassDirty。只清 dirty、不把数据发出去，是不允许的。</span></li></ol><p data-lake-id="u85178172" id="u85178172"><span data-lake-id="ue5a1f0d6" id="ue5a1f0d6">MainPipe 在 </span><code data-lake-id="u97baaa1f" id="u97baaa1f"><span data-lake-id="u605f5ee9" id="u605f5ee9">wbReq</span></code><span data-lake-id="u74b6afad" id="u74b6afad"> 握手后才能离开 s3。所以项存在，就表示 Array 的 Meta 已经按这条 Snoop 改完。队列后面只负责把已经决定的应答送出去。</span></p><h3 data-lake-id="vYw8Q" id="vYw8Q"><span data-lake-id="u1db0136f" id="u1db0136f">CMO</span></h3><p data-lake-id="u6890d201" id="u6890d201"><span data-lake-id="u0e0b0eaf" id="u0e0b0eaf">clean：命中 UD 时，数据进入本队列，Meta 在 MainPipe 里改成 UC。队列按带数据的写回发送。</span></p><p data-lake-id="u54f6674b" id="u54f6674b"><span data-lake-id="u226fafca" id="u226fafca">flush：命中 UD 时同样带数据。Meta 改成 I。</span></p><p data-lake-id="uadfc4cb7" id="uadfc4cb7"><span data-lake-id="u65f84768" id="u65f84768">inval：第一版不写回，脏数据丢弃，不进本队列。</span></p><p data-lake-id="u20fbf6ef" id="u20fbf6ef"><span data-lake-id="uec4411a6" id="uec4411a6">zero：不经过本队列。没有独占权限时走 MissQueue。</span></p><p data-lake-id="u2a4bcb3f" id="u2a4bcb3f"><span data-lake-id="u5ae164a3" id="u5ae164a3">CMO 指令何时对 CPU 完成，看 MissQueue 里的 CompCMO，不看本队列释放。但是 clean、flush 必须先看到 </span><code data-lake-id="uc6bda75f" id="uc6bda75f"><span data-lake-id="uee3e4b71" id="uee3e4b71">wbReq</span></code><span data-lake-id="u0fdd38ba" id="u0fdd38ba"> 被本队列收下，处理它的流水才能继续。本队列释放只说明 L2 已经收完这份数据或 Evict。</span></p><h3 data-lake-id="YcTRL" id="YcTRL"><span data-lake-id="u5712bdab" id="u5712bdab">共享且 PassDirty</span></h3><p data-lake-id="u326d5a44" id="u326d5a44"><span data-lake-id="u00ca9674" id="u00ca9674">L2 返回共享，同时又把脏责任交给 L1。L1 不安装成 SD。</span></p><p data-lake-id="ub2a0ce2b" id="ub2a0ce2b"><span data-lake-id="uaa2d92ff" id="uaa2d92ff">refill 的 s3 先把这 64B 交进本队列，再把 Array 安装成 SC。两项在同一拍都要被收下，否则 s3 停住。</span></p><p data-lake-id="u31aa596b" id="u31aa596b"><span data-lake-id="uc1039f58" id="uc1039f58">这项 </span><code data-lake-id="u6c1fa028" id="u6c1fa028"><span data-lake-id="u1dce9f84" id="u1dce9f84">reason=passDirty</span></code><span data-lake-id="ua6087429" id="ua6087429">，</span><code data-lake-id="ub33f8336" id="ub33f8336"><span data-lake-id="uc1a14892" id="uc1a14892">hasData=1</span></code><span data-lake-id="u619b8f9a" id="u619b8f9a">，告诉 L2 的最终状态是 SC，并且脏责任已经交出。它不是 victim。不能编成 WriteBackFull，因为 WriteBackFull 表示 L1 不再持有这行，和“安装成 SC”矛盾。</span></p><p data-lake-id="u041011da" id="u041011da"><span data-lake-id="ua162c640" id="ua162c640">TXEVT 目前只有 Evict 和 WriteBackFull 两种 opcode，没有第三种。因此这一项的通道编码还没有冻结。队列必须单独记住 </span><code data-lake-id="uf408273d" id="uf408273d"><span data-lake-id="u91c0845b" id="u91c0845b">passDirty</span></code><span data-lake-id="u64473793" id="u64473793">，不能临时改成 WriteBackFull 或 Evict。数据仍然要按两拍 TXDAT 发出。在 opcode 冻结之前，不把这项发出去。</span></p><h3 data-lake-id="sQzgD" id="sQzgD"><span data-lake-id="u9539b341" id="u9539b341">什么时候释放</span></h3><table data-lake-id="T3Zwl" id="T3Zwl" margin="true" class="lake-table" style="width: 549px"><colgroup><col width="174"><col width="375"></colgroup><tbody><tr data-lake-id="u33e1d9e7" id="u33e1d9e7"><td data-lake-id="uce8fb531" id="uce8fb531"><p data-lake-id="udafbb344" id="udafbb344"><span data-lake-id="ub02472b2" id="ub02472b2">种类</span></p></td><td data-lake-id="u337b5178" id="u337b5178"><p data-lake-id="u3091db6e" id="u3091db6e"><span data-lake-id="u69f9b332" id="u69f9b332">可以释放的条件</span></p></td></tr><tr data-lake-id="ud1b26244" id="ud1b26244"><td data-lake-id="uc62203af" id="uc62203af"><p data-lake-id="ucfbcc54b" id="ucfbcc54b"><span data-lake-id="u21a5e184" id="u21a5e184">Evict</span></p></td><td data-lake-id="uf41b97d0" id="uf41b97d0"><p data-lake-id="udb7a0588" id="udb7a0588"><span data-lake-id="u73bd25e7" id="u73bd25e7">TXEVT 已被收下，并且 RXRSP 给出完成</span></p></td></tr><tr data-lake-id="u3fcc5d79" id="u3fcc5d79"><td data-lake-id="ube36cb9e" id="ube36cb9e"><p data-lake-id="ufeeec9bb" id="ufeeec9bb"><span data-lake-id="ufe5e3568" id="ufe5e3568">WriteBackFull</span></p></td><td data-lake-id="ufb6fc5f3" id="ufb6fc5f3"><p data-lake-id="u293d4154" id="u293d4154"><span data-lake-id="u672f8948" id="u672f8948">两拍 TXDAT 已被收下，并且完成已到。只有 dbId 不行</span></p></td></tr><tr data-lake-id="u8f1d11aa" id="u8f1d11aa"><td data-lake-id="ud0654fd4" id="ud0654fd4"><p data-lake-id="u777f0861" id="u777f0861"><span data-lake-id="uf5c6ea82" id="uf5c6ea82">SnpResp</span></p></td><td data-lake-id="uac650e34" id="uac650e34"><p data-lake-id="u4dd2ee55" id="u4dd2ee55"><span data-lake-id="udddafc70" id="udddafc70">TXRSP 被 L2 收下的下一拍</span></p></td></tr><tr data-lake-id="u812aad10" id="u812aad10"><td data-lake-id="u2a0ec060" id="u2a0ec060"><p data-lake-id="u0cf7c470" id="u0cf7c470"><span data-lake-id="uf465bb28" id="uf465bb28">SnpRespData</span></p></td><td data-lake-id="u5281f10a" id="u5281f10a"><p data-lake-id="uf37dcffa" id="uf37dcffa"><span data-lake-id="u65fc4af8" id="u65fc4af8">两拍 TXDAT 都被收下的下一拍</span></p></td></tr><tr data-lake-id="u3ab31015" id="u3ab31015"><td data-lake-id="uc27b0f9d" id="uc27b0f9d"><p data-lake-id="ub8d4ada9" id="ub8d4ada9"><span data-lake-id="u1d4d1089" id="u1d4d1089">passDirty</span></p></td><td data-lake-id="u3bdea17c" id="u3bdea17c"><p data-lake-id="ud5531142" id="ud5531142"><span data-lake-id="uc1720297" id="uc1720297">通道编码冻结之后，按那条事务的完成条件。当前不发送</span></p></td></tr></tbody></table><p data-lake-id="u4e6ea820" id="u4e6ea820"><span data-lake-id="u6b121965" id="u6b121965">释放之后 </span><code data-lake-id="uec3bb2af" id="uec3bb2af"><span data-lake-id="u006791a2" id="u006791a2">wbBlock</span></code><span data-lake-id="u2f71718c" id="u2f71718c"> 不再挡住这个地址。MSHR 不会因为这项释放就释放。CompAck、pending snoop 仍由 MissQueue 自己判断。</span></p><h2 data-lake-id="m3cYL" id="m3cYL"><span data-lake-id="u937f73f1" id="u937f73f1">存储组织与数据结构</span></h2><p data-lake-id="u9abef45a" id="u9abef45a"><span data-lake-id="uac42d824" id="uac42d824">WriteBackEntry，共18条entry。</span></p><table data-lake-id="ZdWQ7" id="ZdWQ7" class="lake-table" style="width: 574px"><colgroup><col width="91"><col width="86"><col width="397"></colgroup><tbody><tr data-lake-id="u2ed4882e" id="u2ed4882e"><td data-lake-id="u0b57c870" id="u0b57c870"><p data-lake-id="u5805b54a" id="u5805b54a"><span data-lake-id="u114c19bf" id="u114c19bf">字段</span></p></td><td data-lake-id="u99126311" id="u99126311"><p data-lake-id="u826b930b" id="u826b930b"><span data-lake-id="uf90f9a53" id="uf90f9a53">位宽</span></p></td><td data-lake-id="u2697cb59" id="u2697cb59"><p data-lake-id="u5ec897df" id="u5ec897df"><span data-lake-id="u7a81c69f" id="u7a81c69f">作用</span></p></td></tr><tr data-lake-id="u27a3b793" id="u27a3b793"><td data-lake-id="u634bb3bd" id="u634bb3bd"><p data-lake-id="u4133b3b3" id="u4133b3b3"><span data-lake-id="u9565aaeb" id="u9565aaeb" class="lake-fontsize-10">opcode</span></p></td><td data-lake-id="u0ded7a32" id="u0ded7a32"><p data-lake-id="u372da085" id="u372da085"><span data-lake-id="ufd0224b7" id="ufd0224b7" class="lake-fontsize-10">3</span></p></td><td data-lake-id="ud912cf39" id="ud912cf39"><p data-lake-id="u61cea7cb" id="u61cea7cb"><span data-lake-id="u6725d1bd" id="u6725d1bd" class="lake-fontsize-10">内部编码：</span><code data-lake-id="u21a80354" id="u21a80354"><span data-lake-id="u5ea7e6cc" id="u5ea7e6cc" class="lake-fontsize-9">Evict</span></code><span data-lake-id="u191404d1" id="u191404d1" class="lake-fontsize-10"> </span><span data-lake-id="u77aa50e1" id="u77aa50e1" class="lake-fontsize-10">/</span><span data-lake-id="ue2bf32ef" id="ue2bf32ef" class="lake-fontsize-10"> </span><code data-lake-id="u363d4d8b" id="u363d4d8b"><span data-lake-id="u3f2fa7fa" id="u3f2fa7fa" class="lake-fontsize-9">WriteEvictFull</span></code><span data-lake-id="u3804070e" id="u3804070e" class="lake-fontsize-10"> </span><span data-lake-id="ubdc97402" id="ubdc97402" class="lake-fontsize-10">/</span><span data-lake-id="ue3a640eb" id="ue3a640eb" class="lake-fontsize-10"> </span><code data-lake-id="u186e3c4f" id="u186e3c4f"><span data-lake-id="u8fe260e5" id="u8fe260e5" class="lake-fontsize-9">WriteBackFull</span></code><span data-lake-id="u87b5e871" id="u87b5e871" class="lake-fontsize-10"> </span><span data-lake-id="uc1667de4" id="uc1667de4" class="lake-fontsize-10">/</span><span data-lake-id="uade64e84" id="uade64e84" class="lake-fontsize-10"> </span><code data-lake-id="ue982a5fc" id="ue982a5fc"><span data-lake-id="ue77d5b98" id="ue77d5b98" class="lake-fontsize-9">SnpResp</span></code><span data-lake-id="u073f1af3" id="u073f1af3" class="lake-fontsize-10"> </span><span data-lake-id="ubf081b0a" id="ubf081b0a" class="lake-fontsize-10">/</span><span data-lake-id="uc5d19809" id="uc5d19809" class="lake-fontsize-10"> </span><code data-lake-id="u95584ee7" id="u95584ee7"><span data-lake-id="ucc36efdd" id="ucc36efdd" class="lake-fontsize-9">SnpRespData</span></code><span data-lake-id="u08960628" id="u08960628" class="lake-fontsize-10">。决定走哪条通道、带不带数据、要不要等完成</span></p></td></tr><tr data-lake-id="u6bd4d055" id="u6bd4d055"><td data-lake-id="ud671b8e5" id="ud671b8e5"><p data-lake-id="ub4dc6b31" id="ub4dc6b31"><span data-lake-id="uaf96edd6" id="uaf96edd6" class="lake-fontsize-10">resp</span></p></td><td data-lake-id="u9ef6429f" id="u9ef6429f"><p data-lake-id="uf10e4ff2" id="uf10e4ff2"><span data-lake-id="u8fc85f3d" id="u8fc85f3d" class="lake-fontsize-10">3</span></p></td><td data-lake-id="u111e45d9" id="u111e45d9"><p data-lake-id="u6502717b" id="u6502717b"><span data-lake-id="u9b5c24ed" id="u9b5c24ed" class="lake-fontsize-10">这笔事务结束后的 CHI 状态。主动写回恒为</span><span data-lake-id="u1dbec72e" id="u1dbec72e" class="lake-fontsize-10"> </span><code data-lake-id="ube21f087" id="ube21f087"><span data-lake-id="u7e10acea" id="u7e10acea" class="lake-fontsize-9">I</span></code><span data-lake-id="u39ffc609" id="u39ffc609" class="lake-fontsize-10">；snoop 来自</span><span data-lake-id="ub7761494" id="ub7761494" class="lake-fontsize-10"> </span><code data-lake-id="ua5f076e5" id="ua5f076e5"><span data-lake-id="ucdcff4d3" id="ucdcff4d3" class="lake-fontsize-9">probe_new_coh</span></code><span data-lake-id="u3396f923" id="u3396f923" class="lake-fontsize-10">，可以是</span><span data-lake-id="ud3752199" id="ud3752199" class="lake-fontsize-10"> </span><code data-lake-id="u7ec202c4" id="u7ec202c4"><span data-lake-id="udba4c70b" id="udba4c70b" class="lake-fontsize-9">I</span></code><span data-lake-id="u1b2ad344" id="u1b2ad344" class="lake-fontsize-10"> </span><span data-lake-id="ud01b3705" id="ud01b3705" class="lake-fontsize-10">/</span><span data-lake-id="u04dca50b" id="u04dca50b" class="lake-fontsize-10"> </span><code data-lake-id="uc3dc5508" id="uc3dc5508"><span data-lake-id="u0c89b51a" id="u0c89b51a" class="lake-fontsize-9">SC</span></code><span data-lake-id="u2f19f1d8" id="u2f19f1d8" class="lake-fontsize-10"> </span><span data-lake-id="u880f8439" id="u880f8439" class="lake-fontsize-10">/</span><span data-lake-id="u7e1c8905" id="u7e1c8905" class="lake-fontsize-10"> </span><code data-lake-id="ud4340543" id="ud4340543"><span data-lake-id="u6d0b103b" id="u6d0b103b" class="lake-fontsize-9">UC</span></code><span data-lake-id="u5d52a3be" id="u5d52a3be" class="lake-fontsize-10"> </span><span data-lake-id="u51a46410" id="u51a46410" class="lake-fontsize-10">/</span><span data-lake-id="u3b2d5576" id="u3b2d5576" class="lake-fontsize-10"> </span><code data-lake-id="u74376893" id="u74376893"><span data-lake-id="u53a529a6" id="u53a529a6" class="lake-fontsize-9">UD</span></code></p></td></tr><tr data-lake-id="ud8075654" id="ud8075654"><td data-lake-id="ubc306527" id="ubc306527"><p data-lake-id="u9a065a2a" id="u9a065a2a"><span data-lake-id="u1df92dff" id="u1df92dff" class="lake-fontsize-10">respErr</span></p></td><td data-lake-id="u921baa1d" id="u921baa1d"><p data-lake-id="ub52317c6" id="ub52317c6"><span data-lake-id="ua16131b2" id="ua16131b2" class="lake-fontsize-10">2</span></p></td><td data-lake-id="u0d073cce" id="u0d073cce"><p data-lake-id="u3751e5a3" id="u3751e5a3"><span data-lake-id="u93ac6f6c" id="u93ac6f6c" class="lake-fontsize-10">控制 flit 的错误。正常是</span><span data-lake-id="udf4f226c" id="udf4f226c" class="lake-fontsize-10"> </span><code data-lake-id="u11647651" id="u11647651"><span data-lake-id="u382dcfb8" id="u382dcfb8" class="lake-fontsize-9">OK</span></code><span data-lake-id="u5fa5ab1a" id="u5fa5ab1a" class="lake-fontsize-10">；tag error 没有 data beat，用</span><span data-lake-id="ua8170a5f" id="ua8170a5f" class="lake-fontsize-10"> </span><code data-lake-id="u936d9471" id="u936d9471"><span data-lake-id="uaa6c0187" id="uaa6c0187" class="lake-fontsize-9">NDERR</span></code></p></td></tr><tr data-lake-id="u07ee433b" id="u07ee433b"><td data-lake-id="ucd900299" id="ucd900299"><p data-lake-id="uc097fbc3" id="uc097fbc3"><span data-lake-id="u2884ca5d" id="u2884ca5d" class="lake-fontsize-10">passDirty</span></p></td><td data-lake-id="ub8812b01" id="ub8812b01"><p data-lake-id="u7711acf0" id="u7711acf0"><span data-lake-id="ubd6d471a" id="ubd6d471a" class="lake-fontsize-10">1</span></p></td><td data-lake-id="u7adb9aac" id="u7adb9aac"><p data-lake-id="u0c7a60de" id="u0c7a60de"><span data-lake-id="u5af8a8e3" id="u5af8a8e3" class="lake-fontsize-10">只给</span><span data-lake-id="u1436afaf" id="u1436afaf" class="lake-fontsize-10"> </span><code data-lake-id="u6ed13ee6" id="u6ed13ee6"><span data-lake-id="u80850685" id="u80850685" class="lake-fontsize-9">SnpRespData</span></code><span data-lake-id="u1a990cc0" id="u1a990cc0" class="lake-fontsize-10">。交出去的数据是脏的则为 1。主动写回的脏不脏已经在 opcode 里</span></p></td></tr><tr data-lake-id="uccef50c5" id="uccef50c5"><td data-lake-id="u16b14fd2" id="u16b14fd2"><p data-lake-id="u33c068bd" id="u33c068bd"><span data-lake-id="u50052c33" id="u50052c33" class="lake-fontsize-10">snpTxnID</span></p></td><td data-lake-id="uf16b0bd9" id="uf16b0bd9"><p data-lake-id="u1341bec2" id="u1341bec2"><span data-lake-id="ue8e475d5" id="ue8e475d5" class="lake-fontsize-10">TxnIDBits</span></p></td><td data-lake-id="u9cc83b4f" id="u9cc83b4f"><p data-lake-id="u903eac5e" id="u903eac5e"><span data-lake-id="u37384143" id="u37384143" class="lake-fontsize-10">进来的 SNP 的 TxnID。只有</span><span data-lake-id="u3b259193" id="u3b259193" class="lake-fontsize-10"> </span><code data-lake-id="u9d6b2fb6" id="u9d6b2fb6"><span data-lake-id="ub9e2ce09" id="ub9e2ce09" class="lake-fontsize-9">SnpResp</span></code><span data-lake-id="uef4aa442" id="uef4aa442" class="lake-fontsize-10"> </span><span data-lake-id="ufe4e420d" id="ufe4e420d" class="lake-fontsize-10">/</span><span data-lake-id="uefa815f0" id="uefa815f0" class="lake-fontsize-10"> </span><code data-lake-id="u0cba3488" id="u0cba3488"><span data-lake-id="ua8d2a18f" id="ua8d2a18f" class="lake-fontsize-9">SnpRespData</span></code><span data-lake-id="ue89db048" id="ue89db048" class="lake-fontsize-10"> </span><span data-lake-id="u56710098" id="u56710098" class="lake-fontsize-10">回填它。宽度跟链路定义走，不是</span><span data-lake-id="u8b961b83" id="u8b961b83" class="lake-fontsize-10"> </span><code data-lake-id="ue630c86c" id="ue630c86c"><span data-lake-id="ue9e14473" id="ue9e14473" class="lake-fontsize-9">log2(entry 数)</span></code></p></td></tr><tr data-lake-id="u658d0b41" id="u658d0b41"><td data-lake-id="u9f6797cc" id="u9f6797cc"><p data-lake-id="ud25dce36" id="ud25dce36"><span data-lake-id="u29725c80" id="u29725c80" class="lake-fontsize-10">addr</span></p></td><td data-lake-id="u01d4b6b6" id="u01d4b6b6"><p data-lake-id="uec413454" id="uec413454"><span data-lake-id="u0be05bc1" id="u0be05bc1" class="lake-fontsize-10">42</span></p></td><td data-lake-id="u7ba0eefa" id="u7ba0eefa"><p data-lake-id="u3e294ca0" id="u3e294ca0"><span data-lake-id="u47c6a196" id="u47c6a196" class="lake-fontsize-10">块地址。默认</span><span data-lake-id="u48172590" id="u48172590" class="lake-fontsize-10"> </span><code data-lake-id="u806398fc" id="u806398fc"><span data-lake-id="udfbd3b43" id="udfbd3b43" class="lake-fontsize-9">PAddrBits = 48</span></code><span data-lake-id="u0e2033aa" id="u0e2033aa" class="lake-fontsize-10">，块大小 64B，低 6 位恒为 0。冲突检查和 flit 地址都用它</span></p></td></tr><tr data-lake-id="u3c0214bf" id="u3c0214bf"><td data-lake-id="ue7516e33" id="ue7516e33"><p data-lake-id="u8f1fe012" id="u8f1fe012"><span data-lake-id="u5dc5774f" id="u5dc5774f" class="lake-fontsize-10">data</span></p></td><td data-lake-id="u0109b099" id="u0109b099"><p data-lake-id="u69aff5a3" id="u69aff5a3"><span data-lake-id="uc38cbcf1" id="uc38cbcf1" class="lake-fontsize-10">512</span></p></td><td data-lake-id="ubfb11aa3" id="ubfb11aa3"><p data-lake-id="u15ed26d9" id="u15ed26d9"><span data-lake-id="ub5c1d918" id="ub5c1d918" class="lake-fontsize-10">整行数据，64B。分配的下一拍才写入</span></p></td></tr><tr data-lake-id="u6f67fc22" id="u6f67fc22"><td data-lake-id="u6d0fac07" id="u6d0fac07"><p data-lake-id="u59346b70" id="u59346b70"><span data-lake-id="uac885d25" id="uac885d25" class="lake-fontsize-10">dataReady</span></p></td><td data-lake-id="ud617ac7f" id="ud617ac7f"><p data-lake-id="u3e798f1e" id="u3e798f1e"><span data-lake-id="u07817fe0" id="u07817fe0" class="lake-fontsize-10">1</span></p></td><td data-lake-id="u4d73c5b2" id="u4d73c5b2"><p data-lake-id="ud245fe2c" id="ud245fe2c"><span data-lake-id="ubc6cca9d" id="ubc6cca9d" class="lake-fontsize-10">这拍数据已经写进</span><span data-lake-id="ufff8c961" id="ufff8c961" class="lake-fontsize-10"> </span><code data-lake-id="ud3009092" id="ud3009092"><span data-lake-id="u2f801afd" id="u2f801afd" class="lake-fontsize-9">data</span></code><span data-lake-id="uaf819fa0" id="uaf819fa0" class="lake-fontsize-10">。</span><code data-lake-id="ua155bd0a" id="ua155bd0a"><span data-lake-id="u31b23f98" id="u31b23f98" class="lake-fontsize-9">SnpRespData</span></code><span data-lake-id="u092a4591" id="u092a4591" class="lake-fontsize-10"> </span><span data-lake-id="udd0b80bc" id="udd0b80bc" class="lake-fontsize-10">和</span><span data-lake-id="u1845698f" id="u1845698f" class="lake-fontsize-10"> </span><code data-lake-id="ubd5f7f06" id="ubd5f7f06"><span data-lake-id="ua172c54e" id="ua172c54e" class="lake-fontsize-9">WriteData</span></code><span data-lake-id="uffd4cd93" id="uffd4cd93" class="lake-fontsize-10"> </span><span data-lake-id="u9b4aa45f" id="u9b4aa45f" class="lake-fontsize-10">要等它；控制 flit 不用等</span></p></td></tr><tr data-lake-id="ua4e22abd" id="ua4e22abd"><td data-lake-id="uf52cd4f7" id="uf52cd4f7"><p data-lake-id="uedb9ada9" id="uedb9ada9"><span data-lake-id="u80c4b9d6" id="u80c4b9d6" class="lake-fontsize-10">dbid</span></p></td><td data-lake-id="ube697102" id="ube697102"><p data-lake-id="uee3e3a61" id="uee3e3a61"><span data-lake-id="uaeb001fd" id="uaeb001fd" class="lake-fontsize-10">TxnIDBits</span></p></td><td data-lake-id="ua0233976" id="ua0233976"><p data-lake-id="uca441bfa" id="uca441bfa"><code data-lake-id="u398bae49" id="u398bae49"><span data-lake-id="u310c222b" id="u310c222b" class="lake-fontsize-9">CompDBIDResp</span></code><span data-lake-id="u3e01df10" id="u3e01df10" class="lake-fontsize-10"> </span><span data-lake-id="u1d81fc78" id="u1d81fc78" class="lake-fontsize-10">里带回的 DBID。只有</span><span data-lake-id="ua391d3d3" id="ua391d3d3" class="lake-fontsize-10"> </span><code data-lake-id="uefde2f5f" id="uefde2f5f"><span data-lake-id="ub16ec23f" id="ub16ec23f" class="lake-fontsize-9">WriteBackFull</span></code><span data-lake-id="u5d6a470b" id="u5d6a470b" class="lake-fontsize-10"> </span><span data-lake-id="u7cb5ba4f" id="u7cb5ba4f" class="lake-fontsize-10">/</span><span data-lake-id="u82dbef18" id="u82dbef18" class="lake-fontsize-10"> </span><code data-lake-id="u2694cf48" id="u2694cf48"><span data-lake-id="ua545a676" id="ua545a676" class="lake-fontsize-9">WriteEvictFull</span></code><span data-lake-id="ub7151fd1" id="ub7151fd1" class="lake-fontsize-10"> </span><span data-lake-id="u24d2398c" id="u24d2398c" class="lake-fontsize-10">在</span><span data-lake-id="u6c6c2639" id="u6c6c2639" class="lake-fontsize-10"> </span><code data-lake-id="ua53c44ec" id="ua53c44ec"><span data-lake-id="u48b30fe5" id="u48b30fe5" class="lake-fontsize-9">s_dat</span></code><span data-lake-id="ub8c3b264" id="ub8c3b264" class="lake-fontsize-10"> </span><span data-lake-id="u39884f03" id="u39884f03" class="lake-fontsize-10">用它当</span><span data-lake-id="u3d0e5b55" id="u3d0e5b55" class="lake-fontsize-10"> </span><code data-lake-id="ue06664f6" id="ue06664f6"><span data-lake-id="ubabeda8e" id="ubabeda8e" class="lake-fontsize-9">WriteData</span></code><span data-lake-id="u9db75661" id="u9db75661" class="lake-fontsize-10"> </span><span data-lake-id="ubd85effa" id="ubd85effa" class="lake-fontsize-10">的 TxnID</span></p></td></tr><tr data-lake-id="ue4e04226" id="ue4e04226" style="height: 36px"><td data-lake-id="u9bfd551e" id="u9bfd551e"><p data-lake-id="ubaa58e02" id="ubaa58e02"><span data-lake-id="uc847ffad" id="uc847ffad" class="lake-fontsize-10">state</span></p></td><td data-lake-id="u85b13080" id="u85b13080"><p data-lake-id="u1cc10131" id="u1cc10131"><span data-lake-id="u65ddccf9" id="u65ddccf9" class="lake-fontsize-10">2</span></p></td><td data-lake-id="ubfeb9373" id="ubfeb9373"><p data-lake-id="ud13c24aa" id="ud13c24aa"><code data-lake-id="u5378084d" id="u5378084d"><span data-lake-id="u67f7eeec" id="u67f7eeec" class="lake-fontsize-9">s_invalid</span></code><span data-lake-id="ufd5b5c21" id="ufd5b5c21" class="lake-fontsize-10"> / </span><code data-lake-id="u3fbac2b8" id="u3fbac2b8"><span data-lake-id="uf56dad6d" id="uf56dad6d" class="lake-fontsize-9">s_req</span></code><span data-lake-id="u37fc0f5d" id="u37fc0f5d" class="lake-fontsize-10"> / </span><code data-lake-id="ue39eac87" id="ue39eac87"><span data-lake-id="u3b43f7b2" id="u3b43f7b2" class="lake-fontsize-9">s_wait_comp</span></code><span data-lake-id="udec44c22" id="udec44c22" class="lake-fontsize-10"> / </span><code data-lake-id="u94df918a" id="u94df918a"><span data-lake-id="ub4bb8743" id="ub4bb8743" class="lake-fontsize-9">s_dat</span></code><span data-lake-id="ua8fb4902" id="ua8fb4902" class="lake-fontsize-9">，每个WritebackEntry的状态。</span></p></td></tr><tr data-lake-id="u5bdf152f" id="u5bdf152f"><td data-lake-id="u7bb3db07" id="u7bb3db07"><p data-lake-id="u19a4dd3e" id="u19a4dd3e"><span data-lake-id="u708fba16" id="u708fba16" class="lake-fontsize-10">remain</span></p></td><td data-lake-id="u3af73e7a" id="u3af73e7a"><p data-lake-id="ud92e4096" id="ud92e4096"><span data-lake-id="u0b962be2" id="u0b962be2" class="lake-fontsize-10">2</span></p></td><td data-lake-id="u3d2ba967" id="u3d2ba967"><p data-lake-id="u2ede834f" id="u2ede834f"><span data-lake-id="u3a4200fb" id="u3a4200fb" class="lake-fontsize-10">还没发出去的 data beat。当前总线 256 bit，64B 行是 2 拍。进入</span><span data-lake-id="u92c1c952" id="u92c1c952" class="lake-fontsize-10"> </span><code data-lake-id="ue9024afc" id="ue9024afc"><span data-lake-id="ub392c456" id="ub392c456" class="lake-fontsize-9">s_dat</span></code><span data-lake-id="u9e811736" id="u9e811736" class="lake-fontsize-10"> </span><span data-lake-id="u2e0edeb7" id="u2e0edeb7" class="lake-fontsize-10">才置上，不能在分配时就置</span></p></td></tr></tbody></table><h2 data-lake-id="Sc9px" id="Sc9px"><span data-lake-id="u084d8e81" id="u084d8e81">流水级行为</span></h2><p data-lake-id="u75093779" id="u75093779"><span data-lake-id="u64fb3270" id="u64fb3270">本队列没有 s0 到 s3。拍与拍之间是项的状态和通道握手。</span></p><h3 data-lake-id="i1ZZR" id="i1ZZR"><span data-lake-id="u96909d08" id="u96909d08">收下 MainPipe</span></h3><ul list="ubeeb357b"><li fid="udcc7edf3" data-lake-id="ue1900e0f" id="ue1900e0f"><span data-lake-id="u4f769480" id="u4f769480">s3 的 </span><code data-lake-id="ue1d6e877" id="ue1d6e877"><span data-lake-id="u0c1c8fd5" id="u0c1c8fd5">wbReq.valid</span></code><span data-lake-id="u410598de" id="u410598de"> 且有空项、地址不冲突：当拍写入控制字段，项离开空闲。</span></li><li fid="udcc7edf3" data-lake-id="ue9fe6f98" id="ue9fe6f98"><span data-lake-id="u3532783f" id="u3532783f">数据在下一拍写入。这一拍若 </span><code data-lake-id="u27c6a8b9" id="u27c6a8b9"><span data-lake-id="u54c87cb1" id="u54c87cb1">hasData=1</span></code><span data-lake-id="u6f950cc4" id="u6f950cc4">，发送数据的资格还没有。</span></li><li fid="udcc7edf3" data-lake-id="u9a9b28d0" id="u9a9b28d0"><span data-lake-id="u7c48223c" id="u7c48223c">同一拍只能收一条。MainPipe 只有一个 </span><code data-lake-id="uee0a172b" id="uee0a172b"><span data-lake-id="u2ec794f0" id="u2ec794f0">wbReq</span></code><span data-lake-id="uf02ec70b" id="uf02ec70b">。</span></li><li fid="udcc7edf3" data-lake-id="u61b9bec5" id="u61b9bec5"><span data-lake-id="u5be8a086" id="u5be8a086">ready 为 0 时，MainPipe 保持 s3，Array 的写也不能先发生。</span></li></ul><h3 data-lake-id="K192K" id="K192K"><span data-lake-id="u6e08c187" id="u6e08c187">选 TXEVT</span></h3><ul list="u030eb757"><li fid="u406be5c6" data-lake-id="u07570634" id="u07570634"><span data-lake-id="u6e1114b1" id="u6e1114b1">空闲拍里，编号最小且需要 TXEVT 的项获得这条通道。</span></li><li fid="u406be5c6" data-lake-id="u744b0411" id="u744b0411"><span data-lake-id="ue8ed2449" id="ue8ed2449">payload 保持到 L2 ready。不能因为另一项优先级更高而改地址或 opcode。</span></li><li fid="u406be5c6" data-lake-id="u910a9f21" id="u910a9f21"><span data-lake-id="u2cdf14dd" id="u2cdf14dd">fire 之后这项进入等响应。TXEVT 本身不带数据。</span></li></ul><h3 data-lake-id="IKgNa" id="IKgNa"><span data-lake-id="uaa553333" id="uaa553333">收 RXRSP</span></h3><ul list="u92748780"><li fid="ue865ab36" data-lake-id="ue1cfd3dc" id="ue1cfd3dc"><span data-lake-id="ucb6cff26" id="ucb6cff26">边界已经按 txnId 17～34 把响应送到本队列。其他编号不会到。</span></li><li fid="ue865ab36" data-lake-id="u9da9cb8e" id="u9da9cb8e"><span data-lake-id="u662577c2" id="u662577c2">对上项号之后，当拍记下 dbId、完成，或两者都记下。</span></li><li fid="ue865ab36" data-lake-id="ua6f754a9" id="ua6f754a9"><span data-lake-id="uf271807e" id="uf271807e">项还没准备好接收时，这一路 </span><code data-lake-id="ud10f5450" id="ud10f5450"><span data-lake-id="u6c15ec2a" id="u6c15ec2a">ready=0</span></code><span data-lake-id="u14c6e8e5" id="u14c6e8e5">，L2 保持 payload。正常情况下等响应的项总是能收，不依赖 MainPipe。</span></li><li fid="ue865ab36" data-lake-id="u2a3193cd" id="u2a3193cd"><span data-lake-id="uc497f1d2" id="uc497f1d2">编号对不上任何有效项，视为协议错误。不分配新项，也不把 dbId 写进别的项。</span></li></ul><h3 data-lake-id="HhtKV" id="HhtKV"><span data-lake-id="u080fe8d6" id="u080fe8d6">选 TXDAT</span></h3><ul list="u7fae032b"><li fid="ud70e6165" data-lake-id="ua3a56ba6" id="ua3a56ba6"><span data-lake-id="uc8e727b2" id="uc8e727b2">可以发送的条件：数据已经写入；若是 WriteBackFull，还要 </span><code data-lake-id="u469ed5b8" id="u469ed5b8"><span data-lake-id="ub45340f2" id="ub45340f2">dbidValid=1</span></code><span data-lake-id="u25801b43" id="u25801b43">；若是 SnpRespData，不需要 dbId。</span></li><li fid="ud70e6165" data-lake-id="u9f1e1cb4" id="u9f1e1cb4"><span data-lake-id="u8e20448b" id="u8e20448b">选中后先发 </span><code data-lake-id="u4cf8cdf4" id="u4cf8cdf4"><span data-lake-id="uff3270dd" id="uff3270dd">dataId=0</span></code><span data-lake-id="u5e246234" id="u5e246234">。这一拍 fire 之后，下一次仍是这项，发 </span><code data-lake-id="u509e9c02" id="u509e9c02"><span data-lake-id="u62d4cb3a" id="u62d4cb3a">dataId=1</span></code><span data-lake-id="u7c5743d0" id="u7c5743d0">。</span></li><li fid="ud70e6165" data-lake-id="u8b454106" id="u8b454106"><code data-lake-id="u4cfe5f3a" id="u4cfe5f3a"><span data-lake-id="u7c0e9e5e" id="u7c0e9e5e">ready=0</span></code><span data-lake-id="uc3dfb0ba" id="uc3dfb0ba"> 时重复同一拍，dataId 不变。</span></li><li fid="ud70e6165" data-lake-id="u5a213780" id="u5a213780"><span data-lake-id="uf10f4a95" id="uf10f4a95">两拍都 fire 后，这项不再参加 TXDAT 仲裁。</span></li></ul><h3 data-lake-id="BGerA" id="BGerA"><span data-lake-id="u6df015e9" id="u6df015e9">选 SnpResp</span></h3><ul list="u39858a26"><li fid="ubdf2cb88" data-lake-id="u1b361565" id="u1b361565"><span data-lake-id="ue114a029" id="ue114a029">无数据 Snoop 项准备好 TXRSP payload。</span></li><li fid="ubdf2cb88" data-lake-id="udf4b8792" id="udf4b8792"><span data-lake-id="u95817dc8" id="u95817dc8">是否真正送到 L2，还要看边界上和 CompAck 的仲裁。</span></li><li fid="ubdf2cb88" data-lake-id="u85b793ba" id="u85b793ba"><span data-lake-id="u6d015525" id="u6d015525">没赢就保持。赢了并 fire 之后，这项下一拍释放。</span></li></ul><h2 data-lake-id="QcunU" id="QcunU"><span data-lake-id="u196a2d17" id="u196a2d17">状态机行为</span></h2><p data-lake-id="u6960e891" id="u6960e891"><span data-lake-id="u76a55b86" id="u76a55b86">一项按原因走不同的状态。</span></p><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22latex%22%2C%22code%22%3A%22Evict%5Cn%E7%A9%BA%E9%97%B2%20-%3E%20%E5%8F%91%20TXEVT%20-%3E%20%E7%AD%89%E5%AE%8C%E6%88%90%20-%3E%20%E7%A9%BA%E9%97%B2%5Cn%5CnWriteBackFull%5Cn%E7%A9%BA%E9%97%B2%20-%3E%20%E7%AD%89%E6%95%B0%E6%8D%AE%E5%86%99%E5%85%A5%20-%3E%20%E5%8F%91%20TXEVT%20-%3E%20%E7%AD%89%20DBID%20-%3E%20%E5%8F%91%E4%B8%A4%E6%8B%8D%20TXDAT%20-%3E%20%E7%AD%89%E5%AE%8C%E6%88%90%20-%3E%20%E7%A9%BA%E9%97%B2%5Cn%E8%8B%A5%E5%AE%8C%E6%88%90%E6%9D%A5%E5%BE%97%E6%AF%94%E6%95%B0%E6%8D%AE%E6%97%A9%EF%BC%8C%E7%AD%89%E5%AE%8C%E6%88%90%E5%B9%B6%E8%BF%9B%E2%80%9C%E5%8F%91%E4%B8%A4%E6%8B%8D%E2%80%9D%EF%BC%8C%E6%95%B0%E6%8D%AE%E5%8F%91%E5%AE%8C%E7%9B%B4%E6%8E%A5%E5%9B%9E%E7%A9%BA%E9%97%B2%E3%80%82%5Cn%5CnSnpResp%5Cn%E7%A9%BA%E9%97%B2%20-%3E%20%E5%8F%91%20TXRSP%20-%3E%20%E7%A9%BA%E9%97%B2%5Cn%5CnSnpRespData%5Cn%E7%A9%BA%E9%97%B2%20-%3E%20%E7%AD%89%E6%95%B0%E6%8D%AE%E5%86%99%E5%85%A5%20-%3E%20%E5%8F%91%E4%B8%A4%E6%8B%8D%20TXDAT%20-%3E%20%E7%A9%BA%E9%97%B2%5Cn%5CnpassDirty%5Cn%E7%A9%BA%E9%97%B2%20-%3E%20%E7%AD%89%E6%95%B0%E6%8D%AE%E5%86%99%E5%85%A5%20-%3E%20%E5%81%9C%E5%9C%A8%E8%BF%99%E9%87%8C%EF%BC%8C%E7%9B%B4%E5%88%B0%E9%80%9A%E9%81%93%20opcode%20%E5%86%BB%E7%BB%93%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22id%22%3A%22kYPN8%22%7D"></card><p data-lake-id="ue508ccf2" id="ue508ccf2"><br></p>